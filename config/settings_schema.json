  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.typography.settings.header_font_header.content"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "futura_n7",
        "label": "t:settings_schema.typography.settings.type_header_font.label"
      },
      {
        "type": "text",
        "id": "headings_fs_scale",
        "label": "Font Scale",
        "info": "Adjust heading font size globally. 1 is the base, 1.25 is 25% bigger, .5 is 50% smaller, etc.",
        "default": "0.85"
      },
      {
        "type": "text",
        "id": "headings_fs_scale_tablet",
        "label": "Font Scale Tablet",
        "info": "Adjust heading font size globally for tablet-size screens. @1023px and below",
        "default": "0.92"
      },
      {
        "type": "text",
        "id": "headings_fs_scale_mobile",
        "label": "Font Scale Phone",
        "info": "Adjust heading font size globally for phone-size screens. @767px and below",
        "default": "1"
      },
      {
        "type": "header",
        "content": "t:settings_schema.typography.settings.header_font_body.content"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "futura_n4",
        "label": "t:settings_schema.typography.settings.type_body_font.label"
      },
      {
        "type": "range",
        "id": "body_fs_base",
        "label": "Base",
        "min": 6,
        "max": 14,
        "step": 0.5,
        "unit": "px",
        "default": 8.5,
        "info": "Adjust global font size"
      },
      {
        "type": "range",
        "id": "body_fs_base_tablet",
        "label": "Base - Tablet",
        "min": 6,
        "max": 14,
        "step": 0.5,
        "unit": "px",
        "default": 9.5,
        "info": "Adjust global font size for tablet-size screens. @1023px and below"
      },
      {
        "type": "range",
        "id": "body_fs_base_mobile",
        "label": "Base - Phone",
        "min": 6,
        "max": 14,
        "step": 0.5,
        "unit": "px",
        "default": 11,
        "info": "Adjust global font size for phone-size screens. @767px and below"
      }
    ]
