ton_text":"","button_url":"","button_alignment":"center","section_id":""}},"faq_LXTRKff":{"type":"faq","blocks":{"topic_RHhacx":{"type":"topic","settings":{"title":"Supportive Heat for Daily Rituals","content":"<p>The Hearth adds steady, radiant heat and full-spectrum infrared to your practice—perfect for yoga, meditation, or breathwork. It grounds you in warmth while supporting deeper relaxation and detox.<\/p>","type":"info"}},"topic_LPRxED":{"type":"topic","settings":{"title":"A Retreat in Your Living Room","content":"<p>No special room required. Just plug in the Hearth and instantly transform your space into a sanctuary of warmth, light, and calm.<\/p>","type":"info"}},"topic_9m9nnG":{"type":"topic","settings":{"title":"Upgrade Your Cabinet Sauna","content":"<p>The Hearth supercharges your cabinet sauna with penetrating radiant heat and full-spectrum light therapy—delivering deeper detox, better sweat, and more revitalizing results in every session.<\/p>","type":"info"}},"topic_knM3B9":{"type":"topic","settings":{"title":"Closet-Sized Healing Oasis","content":"<p>Small space? Big impact. Add the Hearth to any compact setup—like a closet or corner nook—for a powerful, private sanctuary that fits your life.<\/p>","type":"info"}},"topic_YztjTp":{"type":"topic","settings":{"title":"Build a SuperSauna","content":"<p>Ready to turn things up? Add a Hearth Trio to your Classic FireLight® Sauna to create a higher-heat, higher-intensity sauna experience that works faster and goes deeper.<\/p>","type":"info"}}},"block_order":["topic_RHhacx","topic_LPRxED","topic_9m9nnG","topic_knM3B9","topic_YztjTp"],"name":"Hearth Use Cases","settings":{"color_scheme":"","background_image":"shopify:\/\/shop_images\/hearth-buy-use-cases.png","overlay_background_mobile":false,"content_width":"narrow","container_alignment":"right","keep_accordions_closed":false,"alt_links_view":false,"title":"Using Your Hearth","title_alignment":"center","content":"Turn any space into a SaunaSpace or upgrade your existing SaunaSpace sauna with the Hearth.","content_alignment":"center","button_text":"","button_url":"","button_alignment":"center","section_id":""}},"image_and_text_v4_9C3zGh":{"type":"image-and-text-v4","name":"Perfect Sessions, Every Time","settings":{"color_scheme":"","flip_content_desktop":false,"flip_content_mobile":false,"image":"shopify:\/\/shop_images\/hearth-buy-perfect-sessions.png","title":"Perfect Sessions, Every Time","content":"The Hearth has up to four levels of intensity so you can choose your favorite way to sauna. Switch between one, three, and four bulbs depending on your mood. Whether you're looking for a gentle way to unwind or seeking maximum relief, there's a setting for you.","address":"","button_text":"Learn more","button_url":"shopify:\/\/pages\/hearth-infrared-sauna-panel-learn-more","section_id":""}},"image_and_features_v2_AYfAXV":{"type":"image-and-features-v2","blocks":{"feature_tQBgjd":{"type":"feature","settings":{"title":"Detoxification","svg_code":"<svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"87.4\" height=\"87.396\" viewbox=\"0 0 87.4 87.396\">\n  <path id=\"Path_1400\" data-name=\"Path 1400\" d=\"M49.622,39.844a10.871,10.871,0,1,0-5.942,19.991,11,11,0,0,0,2.282-.241,10.871,10.871,0,0,0,3.66-19.75M45.535,57.588a8.82,8.82,0,1,1-3.668-17.255,8.906,8.906,0,0,1,1.852-.2,8.822,8.822,0,0,1,1.816,17.451m23.8-15.173a7.8,7.8,0,1,0,3.384,4.923,7.754,7.754,0,0,0-3.384-4.923m.576,9.68a5.755,5.755,0,1,1-6.023-8.763A5.78,5.78,0,0,1,65.1,43.2,5.757,5.757,0,0,1,69.913,52.1M80.87,44.722A4.641,4.641,0,1,0,87,47.073a4.607,4.607,0,0,0-6.128-2.352m4.307,5.167a2.59,2.59,0,1,1-.052-1.982,2.572,2.572,0,0,1,.052,1.982M23.937,41.327a7.805,7.805,0,1,0,6.012,9.257,7.815,7.815,0,0,0-6.012-9.257m4.006,8.831a5.755,5.755,0,1,1-4.433-6.825,5.761,5.761,0,0,1,4.433,6.825M4.644,53.6A4.641,4.641,0,1,0,0,48.961,4.645,4.645,0,0,0,4.644,53.6m0-7.232a2.591,2.591,0,1,1-2.591,2.591A2.593,2.593,0,0,1,4.644,46.37M39.451,34.121a7.747,7.747,0,0,0,4.235,1.261,7