{% comment %}
    Renders single product media
    Accepts:
    - media: {Object} Liquid media object
    - is_gallery_media: {Boolean} True if media is modal gallery media
    Usage:
    {%- render 'card-result', result: result, class: 'grid__item' -%}
{% endcomment %}

<div class="product__image">
  <div class="media media--transparent js-product-gallery-media" data-media-id="{{- media.id -}}">
    {%- render 'image', image: media -%}
  </div><!-- /.media -->
</div><!-- /.product__image -->
