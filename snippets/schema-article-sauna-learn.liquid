{%- liquid
  assign pub_date = '2025-06-17T00:00:00Z'
  assign mod_date = '2025-07-21T00:00:00Z'
  assign headline = 'How the FireLight® Sauna Heals: Light, Heat and the Design of Transformation'
  assign description = 'Discover how our FireLight® Infrared Sauna blends near infrared light, radiant heat, and EMF shielding into a daily ritual of detox, renewal, and nervous system support—backed by nature, guided by design.'
  assign img = page.metafields.page.featured_image | image_url: width: 1200
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ canonical_url | json }}
  },
  "headline": {{ headline | json }},
  "description": {{ description | json }},
  "image": {
    "@type": "ImageObject",
    "url": {{ img | json }},
    "width": 1200,
    "height": 630
  },
  "author": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | append: '/' | json }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "logo": {
      "@type": "ImageObject",
      "url": {{ settings.logo | image_url: width: 600 | absolute_url | json }}
    }
  },
  "datePublished": "{{ pub_date }}",
  "dateModified": "{{ mod_date }}"
}
</script>