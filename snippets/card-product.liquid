{% comment %}
    Renders a product card
    Accepts:
    - product_ref: {Object} Product Liquid object
    - collection_ref: {Object} Collection Liquid object
    - class: {String} CSS class to apply to the card
    - featured: {Boolean}
    Usage:
    {%- render 'card-product', product_ref: product_ref -%}
{% endcomment %}

{%- assign featured = featured | default: false -%}
{% assign product_title = product_ref.metafields.custom.custom_title | default: product_ref.title %}


{%- capture buttons_html -%}
  <div class="card-product__buttons">
    {%- liquid
      assign value = 'products.product.shop_now' | t
      assign style = 'blurred button--large-desktop button--orange-hover'
      if featured
        assign style = style | replace_first: 'blurred', 'secondary'
      endif
      unless product_ref.available
        assign value = "Sold Out"
        assign style = style | replace_first: '--orange-hover', '--gray-hover'
      endunless

      render 'button' with type: 'link', value: value, href: product_ref.url, style: style

      if product_ref.metafields.custom.secondary_button
        assign value = product_ref.metafields.custom.secondary_button.value.text | escape
        assign href = product_ref.metafields.custom.secondary_button.value.url

        render 'button' with type: 'link', value: value, href: href, style: 'secondary-outlined button--large-desktop button--orange-hover'
      endif
    -%}
  </div>
{%- endcapture -%}

{% liquid
  assign classnames = "card-product"
  if featured
    assign classnames = classnames | append: " card-product--featured"
  endif
  unless product_ref.available
    assign classnames = classnames | append: " product-not-available"
  endunless
  if class != blank
    assign classnames = classnames | append: " " | append: class
  endif
%}
<div class="{{ classnames }}">
  <div class="card-product__media-wrapper relative">
    <a {% if product_ref and product_ref != empty %}href="{{- product_ref.url | within: collection_ref -}} "{% endif %}class="media media--portrait card-product__media">
      {%- if product_ref and product_ref != empty -%}
        <span class="visually-hidden">{{- product_title | escape -}}</span>
      {%- endif -%}

      {%-
        liquid
        if product_ref.featured_media
          render 'image', image: product_ref.featured_media
        else
          echo 'image' | placeholder_svg_tag
        endif
      -%}
    </a>

    {%- if product_ref.metafields.custom.badges -%}
      <div class="card-product__badges">
        {%- for badge in product_ref.metafields.custom.badges.value -%}
          <span class="badge">
            {{- badge | escape -}}
          </span><!-- /.badge -->
        {%- endfor -%}
      </div><!-- /.card-product__badges -->
    {%- endif -%}

    {%- if featured == false -%}
      <div class="card-product__media-overlay small-hide medium-hide">
        {{ buttons_html }}
      </div><!-- /.card-product__media-overlay -->
    {%- endif -%}
  </div><!-- /.card-product__media-wrapper -->

  <div class="card-product__content">
    <div class="card-product__content-head">
      <h4 class="card-product__title">
        {%- if product_ref and product_ref != empty -%}
          <a href="{{- product_ref.url | within: collection_ref -}}" class="link-hover inline-unstyled-link">{{- product_title | escape -}}</a>
        {%- else -%}
          {{- 'products.product.title' | t -}}
        {%- endif -%}
      </h4><!-- /.card-product__title -->

      {%- if featured and product_ref.metafields.custom.subheading -%}
        <p class="card-product__subtitle">
          {{- product_ref.metafields.custom.subheading | escape -}}
        </p><!-- /.card-product__subtitle -->
      {%- endif -%}

      <div class="card-product__price">
        {%- render 'price', product_ref: product_ref, use_variant: true -%}
      </div><!-- /.card-product__price -->
    </div><!-- /.card-product__content-head -->

    {%- if product_ref and product_ref != empty -%}
    {% liquid
      comment
      <!-- If product is the Firelight Sauna Builder product then show the reviews for the original Firelight Sauna product instead -->
      
      if product_ref.id == 14699502862699
        assign reviews_prod_id = 8030925488328
      else
        assign reviews_prod_id = product_ref.id
      endif
      endcomment
    %}
      <div class="card-product__content-body">
        <div data-oke-star-rating data-oke-reviews-product-id="shopify-{{ reviews_prod_id }}" data-product-handle="{{ product_ref.handle }}">
          {{ product_ref.metafields.okendo.StarRatingSnippet }}
        </div>

        {{ buttons_html }}
      </div><!-- /.card-product__content-body -->
    {%- endif -%}
  </div><!-- /.card-product__content -->
</div><!-- /.card-product -->
