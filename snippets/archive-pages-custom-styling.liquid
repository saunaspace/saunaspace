/* Choosing the Right Sauna */

.acc {
	border-bottom: 1px solid var(--charcoal);
}

.acc-term {
	display: block;
	text-decoration: none;
	color: #000;
	font-weight: 700;
	padding: 1em 0;
	border-top: 1px solid var(--charcoal);
	background-image:linear-gradient(#000,#000),linear-gradient(#000,#000); background-repeat: no-repeat; background-size: 1px 19px, 20px 1px; background-position: calc(100% - 20px) 50%, calc(100% - 10px) 50%;
}

.acc-term-minus {
    background-image:linear-gradient(#000,#000); background-repeat: no-repeat; background-size: 20px 1px; background-position: calc(100% - 10px) 50%;
}

.acc-term:hover { cursor: pointer; text-decoration: underline;  }

.sauna-types { margin-bottom: var(--sectionBottom);}
.sauna-types thead tr th { text-align: center; }
.sauna-types thead tr th:first-of-type { text-align: left; padding-left: 0; }
