.sauna-types td, .sauna-types th { padding: 1.5em 2em; border-bottom: 1px solid var(--charcoal); vertical-align: middle; line-height: 1.3em; }
.sauna-types td { text-align: center; position: relative;  }
.sauna-types td:before { content:''; background: rgba(147,147,147,0.2); position: absolute; top: 0; left: 0; width: calc(100% - 20px); height: 100%; margin-left: 10px;  }
.sauna-types td:last-of-type:before { background: rgba(198,122,38,0.2); width: calc(100% - 10px); }

@media all and (max-width: 900px) {
