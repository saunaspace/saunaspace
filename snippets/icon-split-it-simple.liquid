{% liquid
comment
Create a unique ID because this is used in multiple instances on the site which causes issues
endcomment
assign min_val = 1
assign max_val = 1000
assign range_diff = max_val | minus: min_val
assign current_nanoseconds = "now" | date: "%N"
assign random_number = current_nanoseconds | modulo: range_diff | plus: min_val
%}
<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="43" height="15" viewBox="0 0 43 15">
  <defs>
    <pattern id="pattern-si--{{ random_number }}" preserveAspectRatio="none" width="100%" height="100%" viewBox="0 0 1605 574">
      <image width="1605" height="574" xlink:href="data:image/png;base64,"/>
    </pattern>
  </defs>
  <rect width="43" height="15" fill="url(#pattern-si--{{ random_number }})"/>
</svg>
