{% comment %}
    Renders a list of product's price (regular, sale)
    Accepts:
    - product_ref: {Object} Product Liquid object
    - variant: {Object} Product variant Liquid object
    - use_variant: {Boolean} Renders selected or first variant price instead of overall product pricing (optional)
    - price_class: {String} Adds a price class to the price element (optional)
    - show_savings: {Boolean} for product builder
    Usage:
    {% render 'price', product_ref: product %}
{% endcomment %}

{%- liquid
  # If product has a custom pricing product - set that as product_ref
  assign product_ref = product_ref.metafields.custom.pricing_product.value | default: product_ref
  if use_variant
    assign target = variant | default: product_ref.selected_or_first_available_variant
  else
    assign target = product_ref
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign available = target.available | default: false
  assign money_price = price | money

  if target == product_ref and product_ref.price_varies
    assign money_price = 'products.product.price.from_price_html' | t: price: money_price
  endif
-%}

<div class="price
  {%- if price_class %} {{ price_class }}{% endif -%}
  {%- if available == false %} price--sold-out{% endif -%}
  {%- if compare_at_price > price %} price--on-sale{% endif -%}
  {% comment %}{%- if product_ref.price_varies == false and product_ref.compare_at_price_varies %} price--no-compare{% endif -%}{% endcomment %}"
  data-product="{{ product_ref.handle }}"
  >
  <div class="price__container">
    {%- if product_ref -%}
      {% comment %}{%- if compare_at_price > price and product_ref.price_varies == false -%}{% endcomment %}
      {%- if compare_at_price > price -%}
        <div class="price__sale">
          <span class="visually-hidden">{{- 'products.product.price.sale_price' | t -}}</span>

          <ins class="sale-price" data-total-price>{{- money_price -}}</ins>

          {% comment %}<!-- REMOVED: Show compare even if has multiple compare-at prices{%- unless product_ref.price_varies == false and product_ref.compare_at_price_varies %} -->{% endcomment %}
            <span class="visually-hidden">{{- 'products.product.price.regular_price' | t -}}</span>

            <del class="compare-price">{{- compare_at_price | money -}}</del>
          {% comment %}<!-- {%- endunless -%}--> {% endcomment %}
        </div>
      {%- else -%}
        <div class="price__regular">
          <span class="visually-hidden">{{- 'products.product.price.regular_price' | t -}}</span>
          {% if template == "product.sauna" %}
            <span class="totalPrice" data-total-price></span>
            {%- if compare_at_price > price and product_ref.price_varies == false %}
            <del>{{ product_ref.compare_at_price }}</del>
            {%- endif -%}
            <span class="TotalPrice"></span>
            {% comment %}{% if show_savings %}<span class="SavingsPrice"></span>{% endif %}{% endcomment %}
          {% else %}
            <span class="ForChangePrice">{{- money_price -}}</span>
          {% endif %}

        </div>
      {%- endif -%}
    {%- else -%}
      <span>{{- 9999 | money -}}</span>
    {%- endif -%}
  </div>
</div>
