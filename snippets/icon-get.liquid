{%-
  liquid
  case icon
    when 'calendar'
      render 'icon-calendar'

    when 'calendar-alt'
      render 'icon-calendar-alt'

    when 'shield'
      render 'icon-shield'

    when 'returns'
      render 'icon-returns'

    when 'discount'
      render 'icon-discount'

    when 'download'
      render 'icon-download'

    when 'info'
      render 'icon-info'

    when 'user'
      render 'icon-user'

    when 'phone'
      render 'icon-phone'

    when 'email'
      render 'icon-email'

    when 'chat'
      render 'icon-chat'

    else
      echo '<!-- No Icon -->'
  endcase
-%}
