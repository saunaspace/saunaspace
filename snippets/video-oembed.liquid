{% liquid
comment
    Accepts:
    - video {video_url input}
    - class {string}, additional classnames
    - autoplay {boolean}, default true
    - controls {boolean}, default false
    - loop {boolean}, default true
    example: render 'video-oembed', video: section.settings.oembed, class: "section-oembed", autoplay: true, controls: false, loop: true
endcomment

if autoplay != false
    assign autoplay = 1
else
    assign autoplay = 0 
endif

if controls == true
    assign controls = 1
else
    assign controls = 0
endif

if loop == true or loop == blank
    assign loop = 1
else
    assign loop = 0
endif

assign class = "oembed"
if class != blank
    assign classnames = classnames | append: " " | append: class
endif

assign video_platform = video.type

if video_platform == 'youtube'
    comment
        For YouTube: force autoplay=0 so video does not start automatically,
        and remove mute so audio plays on user interaction
    endcomment
    assign params = "?autoplay=0&mute=0&loop=" | append: loop | append: "&controls=" | append: controls | append: "&rel=0"
    if loop
        assign params = params | append: "&playlist=" | append: video.id
    endif
    assign embed_url = 'https://www.youtube.com/embed/' | append: video.id | append: params
else
    comment
        Keep existing behavior for Vimeo and others: respect passed-in autoplay/mute
    endcomment
    assign params = "?autoplay=" | append: autoplay | append: "&muted=1&loop=" | append: loop | append: "&controls=" | append: controls
    assign embed_url = 'https://player.vimeo.com/video/' | append: video.id | append: params
endif

assign aspect_ratio = aspect_ratio | default: '16/9'
%}

{% if container == true %}<div class="iframe-container">{% endif %}
<iframe
    src="{{ embed_url }}"
    width="100%"
    height="auto"
    style="aspect-ratio:{{ aspect_ratio }}"
    data-aspect-ratio="{{ aspect_ratio }}"
    frameborder="0"
    allowfullscreen
    class="{{ classnames }}"
    {% if video_platform == 'youtube' %}allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"{% endif %}
    {% if video_platform == 'vimeo' %}webkitallowfullscreen mozallowfullscreen{% endif %}
></iframe>
{% if container == true %}</div>{% endif %}