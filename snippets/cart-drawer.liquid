{%- comment -%}
  Renders cart drawer

  Usage:
  {%- render 'cart-drawer' -%}
{%- endcomment -%}

{{- 'component-cart-drawer.css' | asset_url | stylesheet_tag -}}

<link rel="stylesheet" href="{{ 'component-cart-items.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>
  {{- 'component-cart-items.css' | asset_url | stylesheet_tag -}}
</noscript>

<script src="{{- 'cart.js' | asset_url -}}" defer="defer"></script>
<script src="{{- 'cart-drawer.js' | asset_url -}}" defer="defer"></script>

<cart-drawer>
  <div class="cart-drawer" id="CartDrawer">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div><!-- /.cart-drawer__overlay -->

    <div
      class="cart-drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{- 'cart.title' | t -}}"
      tabindex="-1"
    >
      <div class="cart-drawer__head" id="CartDrawer-Head">
        <p class="cart-drawer__title h4">
          {{- 'cart.title' | t -}}{% if cart != empty %} ({{ cart.item_count }}){% endif %}
        </p><!-- /.cart-drawer__title h4 -->

        <button
          class="cart-drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{- 'accessibility.close' | t -}}"
          data-drawer-close
        >
          {%- render 'icon-close' -%}
        </button>
      </div><!-- /.cart-drawer__head -->

      <div class="cart-drawer__body" id="CartDrawer-Body">
        {%- if cart == empty -%}
          <div class="cart-drawer__empty">
            {{- 'cart.empty' | t -}}
          </div><!-- /.cart-drawer__empty -->
        {%- else -%}
          <cart-drawer-items>
            <form
              action="{{- routes.cart_url -}}"
              id="CartDrawer-Form"
              class="cart-drawer__form"
              method="post"
            >
              <div class="cart-drawer__contents" id="CartDrawer-CartItems">
                <table class="cart-drawer__items" role="table">
                  <tbody>
                    {%- for line_item in cart.items -%}
                      {%- render 'line-item', line_item: line_item, compact: true -%}
                    {%- endfor -%}
                  </tbody>
                </table><!-- /.cart-drawer__items -->
              </div><!-- /#CartDrawer-CartItems.cart-drawer__contents -->
            </form>
          </cart-drawer-items>

          <div class="cart-drawer__footer">  
            <div class="cart-drawer-discount">
              <details>
                <summary>Have a promo code?</summary>
                <div class="cart-discount-code-input">
                  <div class="docapp-coupon-input"></div>
                </div>
              </details>
            </div>

            <div class="cart-drawer__summary">
              <div class="cart-drawer--summary-financing-options">
                <details>
                  <summary>Financing Available in Checkout</summary>
                  <div class="content-cnt">
                    <div class="row">
                      <a href="javascript:void(0)" style="pointer-events:none;" data-href="https://sauna.space/pages/financing" class="po-link" target="_blank">
                        {%- render 'icon-split-it' -%} <span>Monthly payments using your credit card. 0% APR interest.</span>
                      </a>  
                    </div>
                    <div class="row">
                      <a href="javascript:void(0)" style="pointer-events:none;" data-href="https://sauna.space/pages/truemed-hsa-fsa-payment" class="po-link">
                        {%- render 'icon-truemed' -%} <span>Pay with HSA/FSA Save an average of 30%</span>
                      </a>
                    </div>
                  </div>
                </details>
              </div>

              <form
                action="{{- routes.cart_url -}}"
                id="CartDrawer-FormSummary"
                class="cart-drawer__form-summary"
                method="post"
              >
                {%- render 'cart-summary' -%}
              </form>
            </div><!-- /.cart-drawer__summary -->
          </div><!-- /.cart-drawer__footer -->

        {%- endif -%}
      </div><!-- /.cart-drawer__body -->
    </div><!-- /.cart-drawer__inner -->
  </div><!-- /#CartDrawer.cart-drawer -->
</cart-drawer>
