{% comment %}<!-- For default products: loops through variants as dropdowns. None if product only has default variant -->{% endcomment %}
{% unless product.has_only_default_variant %}
<div class="product__variants" data-file="product-main-default-options">
    {% for option in product.options_with_values %}
    {% if option.name != "Plug" %}
    {% liquid
    assign swatch_count = option.values | map: 'swatch' | compact | size
    assign variant_container_classes = "product__variants-row"
    if swatch_count < 1
        assign variant_container_classes = variant_container_classes | append: " product__variants-row--dropdown variant-option-with-dropdown"
    else
        assign variant_container_classes = variant_container_classes | append: " product__variants-row--swatches"
    endif
    %}
    <div class="{{ variant_container_classes }}" data-variant="{{ option.name }}">
        {% liquid
        assign label_intro = "Select a "
        assign option_first_letter = option.name | slice: 0 | downcase
        if option_first_letter == "a" or option_first_letter == "o" or option_first_letter == "e" or option_first_letter == "i" or option_first_letter == "u"
            assign label_intro = "Select an "
        endif
        %}
        <div class="product__variants-label">
            {{ label_intro | append: option.name }}{% comment %} {% render 'icon-info' %}{% endcomment %}
        </div><!-- /.product__variants-label -->

        {% if swatch_count < 1 %}
        <div class="product__variants-content">
            <details>
                <summary><span data-current-selected-option>{{ option.selected_value }}</span> {% render 'icon-chevron-dropdown' %}</summary>
                <div>
                    <ul class="list-unstyled product-variant-dropdown-options">
                        {% for opt in option.values %}
                        <li class="product__variants-option" data-option="{{ opt }}">
                            <input type="radio" class="{% if opt != blank %}variant-option-radio dropdown-option-radio{% endif %}" name="{{ option.name }}"{% if option.selected_value == opt %} checked="true"{% endif %} value="{{ opt }}" id="dropdown-option--{{ opt | handleize | default: forloop.index }}"{% unless opt.available %} data-disabled{% endunless %} />
                            <label class="variant-option-label" for="dropdown-option--{{ opt | handleize | default: forloop.index }}">
                                {{ opt }}
                            </label>
                        </li>
                        {% endfor %}
                    </ul><!-- /.list-unstyled -->
                </div>
            </details>
        </div>
        {% else %}
            {% comment %}<!-- Color Variants with swatches -->{% endcomment %}
            <ul class="product-build__variant-pills product-build__variant-pills--color colorOption js-variant-options" data-variant="Color">
                {% for opt in option.values %}
                {%- liquid
                assign swatch_value = null
                if opt.swatch.image
                    assign image_url = opt.swatch.image | image_url: width: 100
                    assign swatch_value = 'url(' | append: image_url | append: ')'
                elsif opt.swatch.color
                    assign swatch_value = 'rgb(' | append: opt.swatch.color.rgb | append: ')'
                endif
                # echo "<!-- swatch color: "
                # echo opt | json
                # echo " -->"
                -%}
                <li>
                    <input type="radio" class="color-option product-option-radio option--color"{% if option.selected_value == opt %} checked="true"{% endif %} name="color" value="{{ opt }}" id="color_option_{{ opt | handleize }}"{% unless opt.available %} data-disabled{% endunless %} />
                    <label class="product-build__variant-pill" data-option-name="{{ option.name }}" data-option-value="{{ opt }}" for="color_option_{{ opt | handleize }}">
                        <span class="option-img" style="background:{{ swatch_value }};"></span>
                        <span class="product-build__variant-pill-text">
                        <em>{{ opt }}</em>
                        </span>
                    </label><!-- /.product-build__variant-pill -->
                </li>
                {% endfor %}
            </ul><!-- /.product-build__variant-pills -->
        {% endif %}
    </div>


    {% comment %}<!-- If Plugs Variant -->{% endcomment %}
    {% else %}
    <div class="product__variants-row product__variants-row--dropdown" data-variant="{{ option.name }}">
        <div class="product__variants-label">
            {{ block.settings.panel_title | default: "Plug" }}{% comment %} {% render 'icon-info' %}{% endcomment %}
        </div><!-- /.product__variants-label -->

        <div class="product__variants-content">
            <details>
                <summary><span data-current-selected-plug>{{ option.selected_value | replace: " Adapter", "" }}</span> {% render 'icon-chevron-dropdown' %}</summary>
                <div>
                    <ul class="list-unstyled">
                        {% assign opt = null %}
                        {% for plug_type in shop.metaobjects.plug_types.values %}
                            {% for _opt in option.values %}
                                {% liquid
                                    comment
                                     - Find the option that matches the current plug type
                                    endcomment
                                    assign opt_name = _opt | replace: " Adapter", "" | downcase
                                    assign plug_type_name = plug_type.label | downcase
                                    if opt_name == plug_type_name
                                        assign opt = _opt
                                    endif
                                %}
                            {% endfor %}
                        <li class="product__variants-option" data-plug-option="{{ opt }}" data-plug-type-label="{{ plug_type.label }}">
                            <input type="radio" class="{% if opt != blank %}variant-option-radio plug-option-radio{% endif %}" name="{{ option.name }}"{% if option.selected_value == opt %} checked="true"{% endif %} value="{{ opt }}" id="plug-option--{{ opt | handleize | default: forloop.index }}"{% unless opt.available %} data-disabled{% endunless %} />
                            <label class="variant-option-label" for="plug-option--{{ opt | handleize | default: forloop.index }}">
                                {{ plug_type.label }} {{ plug_type.icon_dropdown_html }}
                            </label>
                        </li>
                        {% endfor %}
                    </ul><!-- /.list-unstyled -->
                </div>
            </details>
        </div><!-- /.product__variants-content -->
    </div>
    {% endif %}
    {% endfor %}{% comment %}<!-- EndOf Loop through variants -->{% endcomment %}
</div>
{% endunless %}