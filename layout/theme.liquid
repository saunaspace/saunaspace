<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    
    <!-- LocalBusiness Schema JSON-LD snippet for Homepage and About Us page -->
    {% if template == 'index' or template == 'page.about-us' %}
      {% render 'schema-localbusiness' %}
    {% endif %}
    <!-- Product Schema JSON-LD either new or used snippet -->
    {% if product.tags contains 'Refurbished' %}
      {% render 'schema-product-used' %}
    {% else %}
      {% render 'schema-product' %}
    {% endif %}
    <!-- Person Schema JSON-LD on About Us page -->
    {% if template == 'page.about-us' %}
      {% render 'schema-person' %}
    {% endif %}
    <!-- Video Schema JSON-LD Logic -->
    {%- case request.path -%}
      {%- when '/' -%}
        {%- render 'schema-video-light' -%}
      {%- when '/pages/firelight-spectrum-revolutionizing-heat-and-light-therapy' -%}
        {%- render 'schema-video-light' -%}
        {%- render 'schema-video-heat' -%}
      {%- when '/blogs/the-wavelength/red-light-therapy-vs-firelight' -%}
        {%- render 'schema-video-light' -%}
      {%- when '/blogs/the-wavelength/best-sauna-for-detox-and-healing' -%}
        {%- render 'schema-video-heat' -%}
    {%- endcase -%}
    
    <!-- Klayvio Viewed Page for 4 Learn Pages -->
    {%- liquid
      if request.page_type == 'page'
        assign learn_templates = 'bulb-learn,glow-learn,hearth-learn,sauna-learn' | split: ','
        if learn_templates contains template.suffix
          render 'klayvio-viewed-page'
        endif
      endif
    -%}

    <!-- Hotjar Tracking Code for sauna.space -->
    <script>
        (function(h,o,t,j,a,r){
            h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
            h._hjSettings={hjid:1685243,hjsv:6};
            a=o.getElementsByTagName('head')[0];
            r=o.createElement('script');r.async=1;
            r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;
            a.appendChild(r);
        })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
    </script>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" data-favicon="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

   <!-- Conditional Meta Title and Description for Shop Policies -->
   {%- case request.path -%}
      {%- when '/policies/shipping-policy' -%}
        <title>Shipping & Delivery Policy | SaunaSpace</title>
        <meta name="description" content="Get free US & Canada shipping on orders $200+. We ship worldwide with fast delivery, insured packages, and responsive customer care.">
      
      {%- when '/policies/refund-policy' -%}
        <title>Returns & Refunds Policy | SaunaSpace 100-Day Home Trial</title>
        <meta name="description" content="Try your infrared sauna risk-free with our 100-Day Home Trial. Learn how returns, exchanges, and refunds work with SaunaSpace’s customer-first care promise.">
    
      {%- when '/policies/privacy-policy' -%}
        <title>Privacy Policy | How SaunaSpace Protects Your Data</title>
        <meta name="description" content="SaunaSpace is GDPR & CCPA compliant. We never share your data. Learn how we collect, use, and protect your personal info with our strict privacy standards.">
    
      {%- when '/policies/terms-of-service' -%}
        <title>Terms of Service | SaunaSpace Website & Purchase Terms</title>
        <meta name="description" content="Review SaunaSpace’s terms for using our website, making purchases, and accessing services. Transparent policies ensure a secure and fair customer experience.">
    
      {%- else -%}
        <title>
          {{ page_title }}
          {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
          {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
          {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
        </title>
    
        {% if page_description %}
          <meta name="description" content="{{ page_description | escape }}">
        {% endif %}
    {%- endcase -%}

    {% render 'meta-tags' %}

    {%- if tinyscript -%}{{ content_for_header }}{%- else -%}{% render 'tiny-script-control' %}{%- endif -%}

    {%- render 'settings' -%}

    {{- 'swiper-bundle.min.css' | asset_url | stylesheet_tag -}}
    {{ 'reset.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{- 'modal-dialog.css' | asset_url | stylesheet_tag -}}
    {{ 'custom.css' | asset_url | stylesheet_tag }}

    {%- unless settings.type_body_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_header_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');

      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>

    {%- comment -%}
      Vendors:
    {%- endcomment -%}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" integrity="sha512-7eHRwcbYkK4d9g/6tD/mhkf++eoTHwpNM9woBxtPUBWm67zeAfFC+HrdoE2GanKeocly/VxeLvIqwvCdk7qScg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.7/dist/ScrollTrigger.min.js" defer="defer" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="{{- 'swiper-bundle.min.js' | asset_url -}}"></script>
    <script src="{{- 'bodyScrollLock.min.js' | asset_url -}}" defer="defer"></script>

    {%- if settings.image_animations -%}
      <script src="{{- 'lazysizes.min.js' | asset_url -}}" defer="defer"></script>
    {%- endif -%}

    {%- if request.design_mode -%}
      <script src="{{- 'theme-scripts.js' | asset_url -}}" defer></script>
    {%- endif -%}

    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    
    <!-- Slider JS on The Wavelength blog homepage -->
    {% if template == 'blog.wavelength' %}
      <script src="{{ 'blog-carousel.js' | asset_url }}" defer></script>
    {% endif %}
    
    {%- render 'header-scripts.zipifypages', renderctx: 'thm' -%}
  </head>

  <body class="template template--{{ template.name }}{% if template.suffix %} template--{{- template.suffix | replace: ".","" -}}{% endif %}">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent">
      {{- 'accessibility.skip_to_text' | t -}}
    </a>

    {%-
      liquid
      unless template == 'cart'
        render 'cart-drawer'
      endunless
      sections 'header-group'
      sections 'popups-group'
      if settings.enable_predictive_search and template != 'search'
        section 'search-popup'
      endif
    -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- sections 'footer-group' -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{- 'accessibility.refresh_page' | t -}}</li>
    </ul>

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_url: '{{ routes.cart_url }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_clear_url: '{{ routes.cart_clear_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}'
      };

      window.cartStrings = {
        error: `{{ 'cart.cart_error' | t }}`,
        quantityError: `{{ 'cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}`
      }
      window.variantStrings = {
        unavailable: '{{ 'products.product.unavailable' | t }}',
        addToCart: '{{ 'products.product.add_to_cart' | t }}',
        soldOut: '{{ 'products.product.sold_out' | t }}',
      }
    </script>
    {%- render 'page-footer.zipifypages', renderctx: 'thm', ocuapp: oneclickupsellapp -%}

    {% render 'pay-over-time' %}

    {% if request.path == '/blogs/the-wavelength' %}
      <!-- Scoped Swiper v11 (only loads on blog homepage) -->
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
      <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer></script>
      <script>
        document.addEventListener('DOMContentLoaded', function () {
          if (typeof Swiper === 'undefined') return;
          document.querySelectorAll('.swiper').forEach((slider) => {
            new Swiper(slider, {
              slidesPerView: 1.2,
              spaceBetween: 16,
              navigation: {
                nextEl: slider.querySelector('.swiper-button-next'),
                prevEl: slider.querySelector('.swiper-button-prev'),
              },
              breakpoints: {
                768: { slidesPerView: 2.5 },
                1024: { slidesPerView: 3.5 },
              },
            });
          });
        });
      </script>
    {% endif %}
    
  {{'tiny-img-link-preloader.js' | asset_url | script_tag }}
  {% render 'freegifts-snippet' %}
</body>
</html>
