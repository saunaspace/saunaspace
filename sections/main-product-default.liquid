{%- assign product_form_id = 'product-form-' | append: section.id -%}

{{- 'section-product.css' | asset_url | stylesheet_tag -}}
{% comment %}{{- 'modal-dialog.css' | asset_url | stylesheet_tag -}}{% endcomment %}
{{ 'modal-quickview.css' | asset_url | stylesheet_tag }}
<script src="{{- 'product-form.js' | asset_url -}}" defer="defer"></script>

<section class="product product-main--{{ product.handle }}" id="MainProduct-{{- section.id -}}" data-section="{{- section.id -}}">
  <div class="product__cols">
    {% render 'product-image-slider-col', product: product %}

    <div class="product__col">
      <div class="product__content">
        {% render 'product-tabs-nav' %}

        <div class="product-main-content-wrap">
          {% render 'product-top-content', product: product, section: section %}

          {% comment %}<!-- Product Variant/Options -->{% endcomment %}
          {% render 'product-main-default-options', product: product, section: section %}
        </div>

        {% render 'product-bottom-content', product: product, section: section %}

        {% render 'product-hidden-inputs', product: product, section: section %}

      </div><!-- /.product__content -->
    </div><!-- /.product__col -->
  </div><!-- /.product__cols -->

  {% render 'product-sticky-button', product: product %}
</section><!-- /.product -->

{% comment %}{%- render 'product-mobile-atc', product_ref: product -%}{% endcomment %}

{%- liquid
  if product.selected_or_first_available_variant.featured_media
    assign seo_media = product.selected_or_first_available_variant.featured_media
  else
    assign seo_media = product.featured_media
  endif
-%}

<script src="{{- 'product-main-default.js' | asset_url -}}" defer="defer"></script>

{% schema %}
{
    "name": "Default Product Main",
    "settings": [
    ],
    "blocks": [
      {
        "type": "@app"
      },
        {
            "name": "Bulb Variant",
            "type": "bulb-variant",
            "settings": [
                {
                    "type": "text",
                    "id": "variant_name",
                    "label": "Variant Name",
                    "default": "Model"
                },
                {
                    "type": "image_picker",
                    "id": "quartet_image",
                    "label": "Quartet Image"
                },
                {
                    "type": "image_picker",
                    "id": "trio_image",
                    "label": "Trio Image"
                },
                {
                    "type": "text",
                    "id": "price_difference",
                    "label": "Price Difference Text",
                    "default": "+$450"
                },
                {
                    "type": "text",
                    "id": "panel_title",
                    "label": "Panel Title",
                    "default": "Bulb Count"
                }
            ]
        },
        {
            "name": "Plug Variant",
            "type": "plug-variant",
            "settings": [
                {
                    "type": "text",
                    "id": "variant_name",
                    "label": "Variant Name",
                    "default": "Plug"
                },
                {
                    "type": "text",
                    "id": "panel_title",
                    "label": "Panel Title",
                    "default": "Plug Type"
                }
            ]
        },
        {
            "name": "Addon Products",
            "type": "addon-products",
            "settings": [
                {
                    "type": "product_list",
                    "id": "addon_products",
                    "label": "Add-on Products"
                },
                {
                    "type": "text",
                    "id": "panel_title",
                    "label": "Panel Title",
                    "default": "Add-Ons"
                }
            ]
        },
        {
            "name": "Variant Dropdown",
            "type": "variant-dropdown",
            "settings": [
                {
                    "type": "text",
                    "id": "variant_name",
                    "label": "Variant Name"
                },
                {
                    "type": "text",
                    "id": "panel_title",
                    "label": "Panel Title",
                    "default": "Select an Option"
                }
            ]
        }
    ]
}
{% endschema %}
