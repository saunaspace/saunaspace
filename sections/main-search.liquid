<div class="container search-pg-alt">
{%- for result in search.results -%}
  {%- case result.object_type -%}

    {%- when 'product' -%}
      {% if result.metafields.custom.search_visible == false %}
        {% continue %}
      {% endif %}
      {% render 'predictive-search-item',
        class: 'predictive-search__item--product search-item--product',
        heading_class: 'caption caption--small',
        resource_item: result,
        image: result.featured_image,
        show_image: true,
        is_product: true
      %}

    {%- when 'page' -%}
      {% if result.metafields.custom.search_visible == false %}
        {% continue %}
      {% endif %}
      {% liquid 
        assign image = 'image' | placeholder_svg_tag
        if result.metafields.page.featured_image != empty
          assign image = result.metafields.page.featured_image
        endif
      %}
      {% render 'predictive-search-item',
        class: 'predictive-search__item--page search-item--page',
        heading_class: 'h6 caption',
        resource_item: result,
        image: image,
        show_image: true
      %}

    {%- when 'article' -%}
      {% if result.metafields.custom.search_visible == false %}
        {% continue %}
      {% endif %}
      {% liquid 
        assign image = 'image' | placeholder_svg_tag
        if result.image != blank
          assign image = result.image
        endif
      %}
      {% render 'predictive-search-item',
        class: 'predictive-search__item--article search-item--article',
        heading_class: 'h6 caption',
        resource_item: result,
        image: image,
        show_image: true
      %}

  {%- endcase -%}
{%- endfor -%}
</div>

{% style %}
.search-pg-alt {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 5rem;
  padding-bottom: 14.8rem;
}
@media screen and (max-width: 1399px) {
  .search-pg-alt {
    gap: 4rem;
    padding-bottom: 8rem;
  }
}
@media screen and (max-width: 989px) {
  .search-pg-alt {
    grid-template-columns: 1fr 1fr;
    gap: 3.6rem;
    padding-bottom: 5rem;
  }
}
@media screen and (max-width: 749px) {
  .search-pg-alt {
    grid-template-columns: 1fr;
    padding-bottom: 3rem;
  }
}
{% endstyle %}


