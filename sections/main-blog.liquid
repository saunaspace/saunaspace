{%- liquid
  assign featured_article = section.settings.featured_article
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile

  assign meta_description = blog.metafields.custom.description.value
-%}

{{- 'section-blog.css' | asset_url | stylesheet_tag -}}
{{- 'article.css' | asset_url | stylesheet_tag -}}

<script src="{{- 'load-more.js' | asset_url -}}" defer></script>

<section class="blog blog--{{ blog.handle }}{%- if current_tags %} blog--filtered{%- endif -%}">
  {%- if current_tags -%}
    <header class="blog__head">
      {%- if image != blank or image_mobile != blank -%}
        <div class="blog__head-image">
          {%- if image != blank -%}
            {{- image | image_url: width: 1920 | image_tag -}}
          {%- endif -%}

          {%- if image_mobile != blank -%}
            {{- image_mobile | image_url: width: 1000 | image_tag -}}
          {%- endif -%}
        </div><!-- /.blog__head-image -->
      {%- endif -%}

      <div class="blog__banner">
        <div class="container">
          <h1 class="blog__title h1 center">
            {{- current_tags[0] | replace: 'Category:', '' | escape -}}
          </h1><!-- /.blog__title h1 center -->
        </div><!-- /.container -->
      </div><!-- /.blog__banner -->
    </header><!-- /.blog__head -->
  {%- else -%}
    <header class="blog__head">
      <div class="blog__banner">
        <div class="container">
          {% if blog.handle == "the-wavelength" %}
          <div class="blog-wavelength-header">
            <div class="header-col header-col-content">
              <p class="subheading">{{ section.settings.header_subheading }}</p>
              <h1 class="blog__title h1 center">{{- blog.title | escape -}}</h1>
              <p class="header-content">{{ section.settings.header_content }}</p>
            </div>
            <div class="header-col header-col-image">
              {% if section.settings.header_image != blank %}
                {{- section.settings.header_image | image_url: width: 600 | image_tag -}}
              {% endif %}
            </div>
          </div>
          {% else %}
          <h1 class="blog__title h1 center">{{- blog.title | escape -}}</h1><!-- /.blog__title h1 center -->

          {%- if meta_description != blank -%}
            <p class="blog__description">
              {{- meta_description | escape | newline_to_br -}}
            </p><!-- /.blog__description -->
          {%- endif -%}
          {% endif %}
        </div><!-- /.container -->
      </div><!-- /.blog__banner -->

      {%- if section.settings.show_filters and blog.all_tags.size > 0 -%}
        <nav class="blog__nav caption center">
          <div class="container container--narrow">
            <ul class="blog__links list-unstyled">
              <li class="blog__link small-hide medium-hide">
                {%-
                  liquid
                  assign link_all_text = 'blog.categories.all.text' | t
                  assign link_all_title = 'blog.categories.all.title' | t
                  assign replace_with = 'class="full-unstyled-link" href'
                  unless current_tags
                    assign replace_with = 'class="full-unstyled-link is-active" href'
                  endunless
                  echo link_all_text | link_to: blog.url, title: link_all_title | replace: 'href', replace_with
                -%}
              </li><!-- /.blog__link -->

              <li class="blog__link large-up-hide">
                {%-
                  liquid
                  assign link_all_text = 'blog.categories.all.text' | t | split: ' ' | first
                  assign link_all_title = 'blog.categories.all.title' | t
                  assign replace_with = 'class="full-unstyled-link" href'
                  unless current_tags
                    assign replace_with = 'class="full-unstyled-link is-active" href'
                  endunless
                  echo link_all_text | link_to: blog.url, title: link_all_title | replace: 'href', replace_with
                -%}
              </li><!-- /.blog__link -->

              {%- for tag in blog.all_tags -%}
                {%- unless tag contains 'Category' -%}
                  {%- continue -%}
                {%- endunless -%}

                <li class="blog__link">
                  {%- liquid
                    assign replace_with = 'class="full-unstyled-link" href'
                    if current_tags contains tag
                      assign replace_with = 'class="full-unstyled-link is-active" href'
                    endif
                  -%}
                  {{- tag | replace: 'Category:', '' | link_to_tag: tag | replace: 'href', replace_with -}}
                </li><!-- /.blog__link -->
              {%- endfor -%}
            </ul><!-- /.blog__links list-unstyled -->
          </div><!-- /.container -->
        </nav><!-- /.blog__nav caption center -->
      {%- endif -%}
    </header><!-- /.blog__head -->
  {%- endif -%}

  {%- unless current_tags -%}
    {%- if featured_article != blank -%}
      <div class="blog__featured-article">
        {% render 'article-hero', article_ref: featured_article, location: 'blog' %}
      </div><!-- /.blog__featured-article -->
    {%- endif -%}
  {%- endunless -%}

  {%- if current_tags -%}
    <div class="blog__back">
      <a href="{{- blog.url -}}" class="link-dot">
        {{- 'blog.home' | t -}}
      </a><!-- /.link-dot -->
    </div><!-- /.blog__back -->
  {%- endif -%}

  {%- paginate blog.articles by 50 -%}{% comment %}<!-- TESTING HERE: WAS by 12 -->{% endcomment %}
    <load-more>
      <div class="blog__body">
        <div class="container">
          {%- if blog.articles_count > 0 -%}
            <div class="blog__grid" js-blog-grid>
              {%- for article_ref in blog.articles -%}
                {%- render 'article', article_ref: article_ref, style: 'small' -%}
              {%- endfor -%}

              {%- if paginate.next -%}
                <div class="blog__grid-actions">
                  <a
                    href="{{ paginate.next.url }}"
                    class="blog__load-more"
                    aria-label="{{- 'general.pagination.next' | t -}}"
                    title="{{- 'general.pagination.next' | t -}}"
                    js-load-more
                  >
                    {{- 'blog.load_more' | t -}}
                  </a>
                </div><!-- /.blog__grid-actions -->
              {%- endif -%}
            </div><!-- /.blog__grid grid -->
          {%- else -%}
            <h2 class="h5 regular center">{{- 'blog.empty' | t -}}</h2><!-- /.h5 regular center -->
          {%- endif -%}
        </div><!-- /.container -->
      </div><!-- /.blog__body -->
    </load-more>
  {%- endpaginate -%}
</section><!-- /.blog -->

{% schema %}
  {
    "name": "Main Blog",
    "settings": [
      {
        "type": "article",
        "id": "featured_article",
        "label": "Featured Article"
      },
      {
        "type": "header",
        "content": "Filtered view"
      },
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image (Desktop)"
      },
      {
        "type": "image_picker",
        "id": "image_mobile",
        "label": "Image (Mobile)"
      },
      {
        "type": "checkbox",
        "id": "show_filters",
        "label": "Show Filters if available",
        "default": true
      },
      {
        "type": "header",
        "content": "Wavelength Blog"
      },
      {
        "type": "text",
        "id": "header_subheading",
        "label": "Header Subheading",
        "default": "Brian Richards Presents:"
      },
      {
        "type": "text",
        "id": "header_content",
        "label": "Header Content",
        "default": "Our founder's blog. Ruminations about sauna, light, electromagnetism, wellness and the inner pharmacy of the human being."
      },
      {
        "type": "image_picker",
        "id": "header_image",
        "label": "Header Image"
      }
    ]
  }
{% endschema %}
