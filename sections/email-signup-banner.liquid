{{- 'section-newsletter.css' | asset_url | stylesheet_tag -}}

<section class="newsletter">
  <div class="container">
    <div class="newsletter__wrapper">
      <h2 class="h3 newsletter__title center">
        {%- liquid
          assign title_default = 'password.title' | t
          echo section.settings.title | default: title_default
        -%}
      </h2><!-- /.h3 newsletter__title center -->

      <div class="newsletter__form">
        {% render 'newsletter-form', namespace: section.id %}
      </div><!-- /.newsletter__form -->
    </div><!-- /.newsletter__wrapper -->
  </div><!-- /.container -->
</section><!-- /.newsletter -->

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.newsletter.settings.title.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.name"
    }
  ]
}
{% endschema %}
