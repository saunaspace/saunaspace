{{- 'component-collection-hero.css' | asset_url | stylesheet_tag -}}

<div class="collection-hero">
  <div class="container container--fullwidth">
    <div class="grid grid--2 grid--center">
      <div class="collection-hero__wrapper">
        <h1 class="collection-hero__title h2">
          <span class="visually-hidden">{{- 'collection.title' | t -}}: </span>
          {{- collection.title | escape -}}
        </h1><!-- /.collection-hero__title h2 -->

        {%- if collection.description != blank -%}
          <div class="collection-hero__entry">
            {{- collection.description -}}
          </div><!-- /.collection-hero__entry -->
        {%- endif -%}
      </div><!-- /.collection-hero__wrapper -->

      {%- if collection.image != blank -%}
        <div class="collection-hero__media">
          <div class="media media--16-9">
            {%- render 'image', image: collection.image -%}
          </div><!-- /.media -->
        </div><!-- /.collection-hero__media -->
      {%- endif -%}
    </div><!-- /.grid -->
  </div><!-- /.container -->
</div><!-- /.collection-hero -->

{% schema %}
  {
    "name": "t:sections.collection-hero.name",
    "settings": []
  }
{% endschema %}
