{% liquid
  if section.settings.section_id != blank
    assign sec_id = section.settings.section_id
  else
    assign sec_id = "section-two-column-images-" | append: section.index
  endif
%}
{%- if section.blocks.size > 0 -%}
  <section class="two-column-images" id="{{ sec_id }}">
    {%- for block in section.blocks -%}
      {%- if block.settings.image == blank -%}
        {%- continue -%}
      {%- endif -%}

      {%- if section.blocks.size > 1 and section.settings.wording != blank -%}
        <span class="two-column-images__wording h2">
          {{- section.settings.wording | escape -}}
        </span><!-- /.two-column-images__wording -->
      {%- endif -%}

      <div class="two-column-images__block">
        <div class="two-column-images__image media">
          {%- render 'image', image: block.settings.image -%}
        </div><!-- /.two-column-images__image -->

        <div class="two-column-images__wrapper">
          <span></span>

          {%- if block.settings.title != blank -%}
            <h2 class="two-column-images__title">
              {{- block.settings.title | escape -}}
            </h2><!-- /.two-column-images__title -->
          {%- endif -%}

          {%- if block.settings.content != blank -%}
            <p class="two-column-images__content">
              {{- block.settings.content | escape | newline_to_br -}}
            </p><!-- /.two-column-images__content -->
          {%- endif -%}
        </div><!-- /.two-column-images__wrapper -->
      </div><!-- /.two-column-images__block -->
    {%- endfor -%}
  </section><!-- /.two-column-images -->
{%- endif -%}

{% style %}
  .two-column-images {
    color: #faf8f2;
    text-align: center;
    aspect-ratio: 16 / 9;
    display: flex;
    flex-flow: row wrap;
    position: relative;
  }

  .two-column-images::after {
    content: '';
    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.83));
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .two-column-images__wording {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    transform: translate(-50%, -50%);
  }

  .two-column-images__block {
    flex: 1;
    min-width: 50%;
    position: relative;
  }

  .two-column-images__image {
    position: absolute;
    inset: 0;
  }

  .two-column-images__wrapper {
    max-width: 67rem;
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    gap: 14.8rem;
    padding: 0 3rem;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .two-column-images__title {
    font-weight: 500;
  }

  .two-column-images__content {
    font-size: calc(var(--fsbase) * 1.8);
    line-height: 2;
  }

  @media screen and (max-width: 1439px) {
    .two-column-images__wrapper {
      gap: 8rem;
    }
  }

  @media screen and (max-width: 1200px) {
    .two-column-images__wrapper {
      gap: 4rem;
    }
  }

  @media screen and (max-width: 1023px) {
    .two-column-images {
      display: block;
      aspect-ratio: initial;
    }

    .two-column-images__wrapper {
      display: block;
      max-width: 100%;
      height: auto;
      padding: 0 4rem;
    }

    .two-column-images__block {
      display: flex;
      align-items: center;
      justify-content: center;
      aspect-ratio: 1;
    }

    .two-column-images::after {
      content: none;
    }

    .two-column-images__block::after {
      content: '';
      background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.83));
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    .two-column-images__title {
      font-size: calc(var(--fsbase) * 3.6);
      margin: 0 0 4.1rem;
    }

    .two-column-images__content {
      font-size: calc(var(--fsbase) * 1.2);
    }
  }
{% endstyle %}

{% schema %}
  {
    "name": "Two-column images",
    "settings": [
      {
        "type": "text",
        "id": "wording",
        "label": "Between-column wording"
      },
      {
        "type": "text",
        "id": "section_id",
        "label": "Section ID"
      }
    ],
    "blocks": [
      {
        "type": "column",
        "name": "Column",
        "limit": 2,
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title"
          },
          {
            "type": "textarea",
            "id": "content",
            "label": "Content"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }
        ]
      }
    ],
    "disabled_on": {
    "groups": ["*"]
    },
    "presets": [
      {
        "name": "Two-column images"
      }
    ]
  }
{% endschema %}
