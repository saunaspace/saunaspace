{% liquid
  if section.settings.section_id != blank
    assign sec_id = section.settings.section_id
  else
    assign sec_id = "content-img-col-blocks-" | append: section.index
  endif
%}
{{- 'section-content-img-col-blocks.css' | asset_url | stylesheet_tag -}}

<div class="content-img-cols" id="{{ sec_id }}">
    <div class="container">
        <div class="content-img-cols__content">
            <div class="content-img-cols-header">
                {% if section.settings.heading != blank %}
                <h2 class="content-img-cols-heading">
                {{- section.settings.heading | replace: "[Truemed]", "<span class='tr-img'>Truemed</span>" -}}
                </h2><!-- /.page-banner__heading -->
                {% endif %}

                {% if section.settings.content != blank %}
                <div class="content-img-cols-header-content">{{ section.settings.content }}</div>
                {% endif %}

                {% if section.settings.button_text != blank and section.settings.button_url != blank %}
                <a href="{{ section.settings.button_url }}" class="button button--outlined">{{ section.settings.button_text }}</a>
                {% endif %}
            </div>

            {% if section.blocks.size > 0 %}
            <div class="content-img-cols-rows">
                {% for block in section.blocks %}
                    {% assign row = block.settings %}
                    <div class="content-row">
                        {% if row.image != blank %}
                        <div class="content-img-col content-img-col--image">
                            <div class="img-cnt">
                                {%-
                                    liquid
                                    assign image = row.image
                                    assign image_src = image | image_url: width: 375
                                    capture image_srcset
                                    render 'srcset', image: image
                                    endcapture
                                    assign image_alt = image.alt | escape
                                    render 'image', src: image_src, srcset: image_srcset, sizes: 'auto', alt: image_alt, width: image.width, height: image.height, focal_point: image.presentation.focal_point
                                -%}
                            </div>
                        </div>
                        {% endif %}

                        <div class="content-img-col content-img-col--content">
                            <div class="inner-wrap">
                                {% if row.title != blank %}
                                <h2 class="content-row-title h5">{{ row.title | replace: "[Truemed]", "<span class='tr-img'>Truemed</span>" }}</h2>
                                {% endif %}

                                {% if row.heading != blank %}
                                <h2 class="content-row-heading h3">{{ row.heading | replace: "[Truemed]", "<span class='tr-img'>Truemed</span>" }}</h2>
                                {% endif %}

                                {% if row.content != blank %}
                                <div class="content-row-content">{{ row.content }}</div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            {% endif %}
        </div>
    </div>
</div>

{% schema %}
{
  "name": "Content + Img Col Blocks",
  "class": "section-content-img-col-blocks",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
        "type": "text",
        "id": "button_text",
        "label": "Button Text"
    },
    {
        "type": "url",
        "id": "button_url",
        "label": "Button Link"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID"
    }
  ],
  "blocks": [
    {
        "name": "Row",
        "type": "row",
        "settings": [
            {
                "type": "text",
                "id": "title",
                "label": "Title"
            },
            {
                "type": "text",
                "id": "heading",
                "label": "Heading"
            },
            {
                "type": "richtext",
                "id": "content",
                "label": "Content"
            },
            {
                "type": "image_picker",
                "id": "image",
                "label": "Image"
            }
        ]
    }
  ],
  "presets": [
    {
        "name": "Content + Img Col Blocks"
    }
  ]
}
{% endschema %}