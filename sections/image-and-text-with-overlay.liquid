{% liquid
  if section.settings.section_id != blank
    assign sec_id = section.settings.section_id
  else
    assign sec_id = "section-image-and-text-with-overlay-" | append: section.index
  endif
%}
{%- if section.settings.heading != blank -%}
  <section class="image-and-text-with-overlay" id="{{ sec_id }}">
    <div class="container">
      <div class="image-and-text-with-overlay__content">
        {%- if section.settings.subheading != blank -%}
          <p class="image-and-text-with-overlay__subtitle">
            {{- section.settings.subheading | escape -}}
          </p><!-- /.image-and-text-with-overlay__subtitle -->
        {%- endif -%}

        <h2 class="image-and-text-with-overlay__title">
          {{- section.settings.heading | escape -}}
        </h2><!-- /.image-and-text-with-overlay__title -->

        {%- if section.settings.content != blank -%}
          <div class="image-and-text-with-overlay__entry">
            {{- section.settings.content | escape | newline_to_br -}}
          </div><!-- /.image-and-text-with-overlay__entry -->
        {%- endif -%}

        {%- if section.settings.link_text != blank and section.settings.link_url != blank -%}
          <a href="{{- section.settings.link_url -}}" class="image-and-text-with-overlay__link">
            {{- section.settings.link_text | escape -}}
          </a>
        {%- endif -%}
      </div><!-- /.image-and-text-with-overlay__content -->

      {%- if section.settings.image != blank -%}
        {{- section.settings.image | image_url: width: 1920 | image_tag: width: nil -}}
      {%- endif -%}
    </div><!-- /.container -->
  </section><!-- /.image-and-text-with-overlay -->
{%- endif -%}

{% style %}
  .image-and-text-with-overlay {
    background-color: #1b100f;
    aspect-ratio: 1920 / 1080;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    position: relative;
  }

  .image-and-text-with-overlay .container {
    width: 100%;
  }

  .image-and-text-with-overlay::before,
  .image-and-text-with-overlay::after {
    content: '';
    width: 100%;
    height: 31.7rem;
    position: absolute;
    left: 0;
    z-index: 1;
  }

  .image-and-text-with-overlay::before {
    background: linear-gradient(to top, transparent, #000);
    top: 0;
  }

  .image-and-text-with-overlay::after {
    background: linear-gradient(to bottom, transparent, #000);
    bottom: 0;
  }

  .image-and-text-with-overlay__content {
    text-align: center;
    max-width: 70rem;
    position: relative;
    z-index: 2;
  }

  .image-and-text-with-overlay__subtitle {
    color: #f4f0e0;
    font-size: calc(var(--fsbase) * 1.8);
    line-height: 2;
    text-transform: uppercase;
    font-weight: 400;
    margin: 0 0 5.3rem;
  }

  .image-and-text-with-overlay__title {
    color: #f0e7da;
    font-family: var(--font-heading-family);
    font-weight: 500;
    font-size: calc(var(--fsbase) * 5.4);
    line-height: 1.2;
    margin: 0 0 6.7rem;
  }

  .image-and-text-with-overlay__entry {
    color: #f0e7da;
    font-size: calc(var(--fsbase) * 2.1);
    line-height: 2;
    font-weight: 500;
    margin: 0 0 5.5rem;
  }

  .image-and-text-with-overlay__link {
    color: #faf8f2;
    text-transform: uppercase;
    font-weight: 800;
    display: inline-flex;
    flex-flow: row wrap;
    align-items: center;
    gap: 0 1.5rem;
    text-decoration: none;
  }

  .image-and-text-with-overlay__link:hover {
    text-decoration: underline;
  }

  .image-and-text-with-overlay__link:before {
    content: '';
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background-color: var(--color-red);
  }

  .image-and-text-with-overlay img {
    object-fit: cover;
    width: 50%;
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
  }

  @media screen and (max-width: 1023px) {
    .image-and-text-with-overlay__content {
      max-width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .image-and-text-with-overlay {
      display: block;
      background: #000;
      padding-bottom: 5.7rem;
    }

    .image-and-text-with-overlay__title {
      font-size: calc(var(--fsbase) * 2.4);
      line-height: 1.5;
      margin: 0 0 2.2rem;
    }

    .image-and-text-with-overlay__subtitle {
      font-size: calc(var(--fsbase) * 1.4);
      line-height: 1.571429;
      margin: 0 0 1.6rem;
    }

    .image-and-text-with-overlay__link {
      gap: 0 1rem;
    }

    .image-and-text-with-overlay__link:before {
      width: 0.8rem;
      height: 0.8rem;
    }

    .image-and-text-with-overlay__entry {
      font-size: calc(var(--fsbase) * 1.2);
      margin: 0 0 2.9rem;
    }

    .image-and-text-with-overlay::before,
    .image-and-text-with-overlay::after {
      height: 17.3rem;
    }

    .image-and-text-with-overlay::after {
      content: none;
    }

    .image-and-text-with-overlay__content {
      padding: 0 2rem;
    }

    .image-and-text-with-overlay .container {
      display: flex;
      flex-direction: column-reverse;
      padding: 0;
    }

    .image-and-text-with-overlay img {
      width: 100%;
      max-width: none;
      display: block;
      margin: 0 0 5rem;
      position: static;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Image/text and overlay",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Link text"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL",
      "default": "/"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID"
    }
  ],
  "disabled_on": {
    "groups": ["*"]
  },
  "presets": [
    {
      "name": "Image/text and overlay"
    }
  ]
}
{% endschema %}
