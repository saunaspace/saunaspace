        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.blocks.blocks.block.settings.content.label"
        },
        {
          "type": "header",
          "content": "Button one"
        },
        {
          "type": "text",
          "id": "button_1_text",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "button_1_url",
          "label": "URL"
        },
        {
          "type": "header",
          "content": "Button two"
        },
        {
          "type": "text",
          "id": "button_2_text",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "button_2_url",
          "label": "URL"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "default": "scheme_1",
          "label": "Color Scheme"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.blocks.name",
      "blocks": [
				{
					"type": "block",
					"settings": {
						"caption": "Caption",
            "heading": "Heading Goes Here",
            "content": "<p>Content goes here.</p>",
            "button_1_text": "Button",
            "button_1_url": "https://example.com",
            "button_2_text": "Button",
            "button_2_url": "https://example.com",
            "color_scheme": "scheme-1"
					}
				},
        {
					"type": "block",
					"settings": {
						"caption": "Caption",
            "heading": "Heading Goes Here",
            "content": "<p>Content goes here.</p>",
            "button_1_text": "Button",
            "button_1_url": "https://example.com",
            "button_2_text": "Button",
            "button_2_url": "https://example.com",
            "color_scheme": "scheme-2"
					}
				}
  		]
    }
  ],
  "disabled_on": {
    "groups": ["*"]
  }
}
{% endschema %}
