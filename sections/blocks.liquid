{%-
  liquid
  assign blocks = section.blocks | where: 'type', 'block'
  assign blocks_markup = ''
-%}

{%- if blocks.size > 0 -%}
  {%- capture blocks_markup -%}
    {%- for block in blocks -%}
      {%-
        liquid
        assign bg_image = block.settings.bg_image
        assign bg_image_mobile = block.settings.bg_image_mobile
        assign bg_image_hover = block.settings.bg_image_hover
        assign caption = block.settings.caption
        assign heading = block.settings.heading
        assign content = block.settings.content
        assign button_1_text = block.settings.button_1_text
        assign button_1_url = block.settings.button_1_url
        assign button_2_text = block.settings.button_2_text
        assign button_2_url = block.settings.button_2_url
        assign color_scheme = block.settings.color_scheme
        assign color_scheme_settings = settings.color_schemes[color_scheme.id].settings
      -%}

      {% style %}
        #{{- section.id -}}-{{- block.id -}} {
          --color-background: {{ color_scheme_settings.background }};
          --color-background_gradient: {{ color_scheme_settings.background_gradient }};
          --color-text: {{ color_scheme_settings.text }};
          --color-button_primary_bg: {{ color_scheme_settings.button_primary_bg }};
          --color-button_primary_text: {{ color_scheme_settings.button_primary_text }};
          --color-button_secondary_bg: {{ color_scheme_settings.button_secondary_bg }};
          --color-button_secondary_text: {{ color_scheme_settings.button_secondary_text }};
        }
      {% endstyle %}

      <div class="blocks__col">
        <div class="block {{ color_scheme -}}" id="{{- section.id -}}-{{- block.id -}}">
          {%- if bg_image != blank -%}
            <div class="block__bg{% if bg_image_mobile != blank %} small-hide medium-hide{% endif %}{% if bg_image_hover != blank %} block__bg--main{% endif %}">
              {%- render 'image', image: bg_image -%}
            </div><!-- /.block__bg -->
          {%- endif -%}

          {%- if bg_image_mobile != blank -%}
            <div class="block__bg large-up-hide{% if bg_image_hover != blank %} block__bg--main{% endif %}">
              {%- render 'image', image: bg_image_mobile -%}
            </div><!-- /.block__bg -->
          {%- endif -%}

          {%- if bg_image_hover != blank -%}
            <div class="block__bg block__bg--hover">
              {%- render 'image', image: bg_image_hover -%}
            </div><!-- /.block__bg -->
          {%- endif -%}

          <div class="block__inner">
            {%- if caption != blank -%}
              <div class="block__caption">
                {{- caption | escape -}}
              </div><!-- /.block__caption -->
            {%- endif -%}

            {%- if heading != blank -%}
              <h3 class="block__heading h3">
                {{ heading | escape }}
              </h3><!-- /.block__heading h3 -->
            {%- endif -%}

            {%- if content != blank -%}
              <div class="block__content rte">
                {{ content }}
              </div><!-- /.block__content rte -->
            {%- endif -%}
          </div><!-- /.block__inner -->

          <div class="block__actions">
            {%- if button_1_text != blank and button_1_url != blank -%}
              {%- render 'button',
                type: 'link',
                value: button_1_text,
                href: button_1_url,
                style: 'secondary button--orange-hover button--large-desktop'
              -%}
            {%- endif -%}

            {%- if button_2_text != blank and button_2_url != blank -%}
              {%- render 'button',
                type: 'link',
                value: button_2_text,
                href: button_2_url,
                style: 'secondary-outlined button--orange-hover button--large-desktop'
              -%}
            {%- endif -%}
          </div><!-- /.block__actions -->
        </div><!-- /.block -->
      </div><!-- /.col -->
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}

<link rel="stylesheet" href="{{ 'blocks.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'block.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>
  {{- 'blocks.css' | asset_url | stylesheet_tag -}}
  {{- 'block.css' | asset_url | stylesheet_tag -}}
</noscript>

<section class="blocks" id="section-blocks-{{ section.index }}">
  <div class="container container--extra-large">
    <div class="blocks__cols">
      {{- blocks_markup -}}
    </div><!-- /.blocks__cols -->
  </div><!-- /.container container--extra-large -->
</section><!-- /.blocks -->

