{{- 'section-article.css' | asset_url | stylesheet_tag -}}

<article class="article blog-article-type--{{ blog.handle }}">
  <header class="article__head center">
    {% render 'article-hero', article_ref: article, location: 'article' %}
  </header><!-- /.article__head center -->

  <div class="article__body">
    {% unless blog.handle == "jobs" %}
    <div class="article__meta flex flex--justify">
      {% liquid
        assign back_button_text = 'article.back' | t
        assign share_button_text = 'article.share' | t
        assign blog_url = blog.url
        if blog.handle == "events" or blog.handle == "jobs"
          assign return_pg_title = blog.title
          assign blog_url = blog_url | replace: "/blogs", "/pages"
          assign share_button_text = "Share Event"
          if blog.handle == "jobs"
            assign return_pg_title = "Careers"
            assign blog_url = blog_url | replace: "job","jobs"
          assign share_button_text = "Share Position"
          endif
          assign back_button_text = back_button_text | replace: "Articles", return_pg_title
        endif
      %}
      <a href="{{- blog_url -}}" class="link-dot">
        {{ back_button_text }}
      </a><!-- /.link-dot -->

      <div class="article__meta-share-wrapper">
        <div class="article__meta-share">
          {{- share_button_text -}}

          {% render 'icon-share-arrow' %}
        </div>

        <div class="article__meta-links">
          {% render 'share' with article as object %}
        </div><!-- /.article__meta-links -->
      </div><!-- /.article__meta-share-wrapper -->
    </div><!-- /.article__meta flex flex--justify -->
    {% endunless %}

    <div class="article__rte rte article-content">
      {% unless blog.handle == "events" %}
      {{- article.content -}}
      {% endunless %}
      {% if blog.handle == "jobs" %}
      <div class="equal-opportunity-disclaimer">
        {% if section.settings.equal_employment_disclaimer != blank %}
        <p>{{ section.settings.equal_employment_disclaimer }}</p>
        {% endif %}
      </div>
      {% endif %}
    </div><!-- /.article__rte rte -->

    <!-- /.article published and updated dates -->
    {% render 'article-dates' %}
     
    {% if blog.handle == "events"%}
      {% if article.image != blank %}
      <div class="event-featured-image">
        {{- article.image | image_url: width: 1540 | image_tag -}}
      </div>
      {% endif %}
      {% assign _event = article.metafields.event %}
      <div class="event-text event-meta-info">
        {% if _event.startdate != blank and _event.enddate != blank %}
        <p class="event-dates"><strong>Dates: </strong>{{ _event.startdate | date: '%B %d, %Y' }}
            {% unless _event.enddate == blank %}
            - {{ _event.enddate | date: '%B %d, %Y' }}
            {% endunless %}
        </p>
        {% endif %}
        
        {% if _event.locationaddr %}
        <div class="event-location">
            <p>{{ _event.locationaddr |  newline_to_br }}</p>
        </div>
        {% endif %}

        {% if _event.description != blank %}
        <div class="event-description">{{ _event.description | metafield_tag }}</div>
        {% endif %}

        {% if _event.registrationlink != blank %}
        <div class="event-link-div">
            <a
            href="{{ _event.registrationlink }}"
            target="_blank"
            class="event-link button">Register</a>
        </div>
        {% endif %}
      </div>
    {% endif %}
  </div><!-- /.article__body -->

  {%- if article.comments_enabled? -%}
    <footer class="article__foot">
      <div class="article__comments" id="comments">
        <p class="h4 article__comments-title">
          {{- 'article.comments.title' | t: count: article.comments_count -}}
        </p><!-- /.h4 article__comments-title -->

        {%- for comment in article.comments -%}
          <div class="article__comment">
            <div class="article__comment-content">
              {{- comment.content -}}
            </div><!-- /.article__comment-content -->

            <div class="article__comment-meta right">
              {%- assign comment_date = 'date_formats.month_year' | t -%}
              <div>
                <strong class="caption">{{- comment.author -}}</strong>
              </div>

              <div>
                <span class="caption color-subdued">{{- comment.created_at | date: comment_date -}}</span>
              </div>
            </div><!-- /.article__comment-meta right -->
          </div><!-- /.article__comment -->
        {%- endfor -%}
      </div><!-- /#comments .article__comments -->

      <div class="article__form">
        {%- form 'new_comment', article -%}
          {%-
            liquid
            assign post_message = 'article.comments.success' | t
            if article.moderated? and comment.status == 'unapproved'
              assign post_message = 'article.comments.success_moderated' | t
            endif
          -%}

          <p class="h4 article__form-title">
            {{- 'article.comments.form.title' | t -}}
          </p><!-- /.h4 article__form-title -->

          <div class="form-row form-row--double">
            {%-
              liquid
              assign label = 'article.comments.form.name.label' | t | append: ' <span aria-hidden="true" class="color-red">*</span>'
              assign placeholder = 'article.comments.form.name.placeholder' | t
              capture attr
                echo 'autocomplete="name"'
                echo 'aria-required="true"'
              endcapture
              if customer
                assign value = customer.name
              else
                assign value = form.author
              endif
              render 'text-input', id: 'CommentForm-author', label: label, placeholder: placeholder, value: value, attr: attr, required: true, name: 'comment[author]'
              assign label = nil
              assign placeholder = nil
              assign attr = nil
              assign value = nil
            -%}

            {%-
              liquid
              assign label = 'article.comments.form.email.label' | t | append: ' <span aria-hidden="true" class="color-red">*</span>'
              assign placeholder = 'article.comments.form.email.placeholder' | t
              capture attr
                echo 'autocomplete="email"'
                echo 'aria-required="true"'
                echo 'autocorrect="off"'
                echo 'autocapitalize="off"'
              endcapture
              if customer
                assign value = customer.email
              else
                assign value = form.email
              endif
              render 'text-input', type: 'email', id: 'CommentForm-email', label: label, placeholder: placeholder, value: value, attr: attr, required: true, name: 'comment[email]'
              assign label = nil
              assign placeholder = nil
              assign attr = nil
              assign value = nil
            -%}
          </div><!-- /.form-row form-row--double -->

          <div class="form-row">
            {%-
              liquid
              assign label = 'article.comments.form.message.label' | t | append: ' <span aria-hidden="true" class="color-red">*</span>'
              assign placeholder = 'article.comments.form.message.placeholder' | t
              assign attr = 'aria-required="true"'
              render 'textarea-input', id: 'CommentForm-body', label: label, placeholder: placeholder, attr: attr, required: true, name: 'comment[body]', body: form.body
              assign label = nil
              assign placeholder = nil
              assign attr = nil
            -%}
          </div><!-- /.form-row -->

          {%- if form.posted_successfully? -%}
            <p class="caption color-subdued" role="status">{{- post_message -}}</p>
          {%- elsif article.moderated? -%}
            <p class="caption color-subdued">{{- 'article.comments.form.hint' | t -}}</p>
          {%- endif -%}

          {%- assign value = 'article.comments.form.submit' | t -%}
          {%- render 'button', type: 'submit', style: 'outlined', value: value -%}
          {%- assign value = nil -%}
        {%- endform -%}
      </div><!-- /.article__form -->
    </footer><!-- /.article__foot -->
  {%- endif -%}
</article><!-- /.article -->

{% if blog.handle == "jobs" and section.settings.careers_contact_email != blank %}
<a href="mailto:{{ section.settings.careers_contact_email }}" id="job-apply-now" class="job-apply-now-floating">
  {{ section.settings.apply_now_text | default: "Apply Now" }}
  <span>{% render 'icon-email' %}</span>
</a>
{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ request.origin | append: page.url | json }}
  },
  "headline": {{ article.title | json }},
  {% if article.excerpt != blank %}
    "description": {{ article.excerpt | strip_html | json }},
  {% endif %}
  {% if article.image %}
    "image": [
      {{ article | image_url: width: article.image.width | prepend: "https:" | json }}
    ],
  {% elsif settings.share_image %}
    "image": [
      {{ settings.share_image | image_url: width: settings.share_image.width | prepend: "https:" | json }}
    ],
  {% endif %}
  "articleBody": {{ article.content | strip_html | json }},
  "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
  "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
  "dateCreated": {{ article.created_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
  "wordCount": {{ article.content | strip_html | split: ' ' | size }},
  "author": {
    "@type": "Person",
    "name": {{ article.author | json }},
    "url": {{ request.origin | append: '/pages/about-us' | json }}
  },
  "publisher": {
    "@type": "Organization",
    {% if settings.share_image %}
      "logo": {
        "@type": "ImageObject",
        "height": {{ settings.share_image.height | json }},
        "url": {{ settings.share_image | image_url: width: settings.share_image.width | prepend: "https:" | json }},
        "width": {{ settings.share_image.width | json }}
      },
    {% endif %}
    "name": {{ shop.name | json }},
    "url": {{ request.origin | json }}
  }
}
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const images = document.querySelectorAll('.article__rte img');

    images.forEach(img => {
      const htmlWidth = img.getAttribute('width');
      const htmlHeight = img.getAttribute('height');

      if (htmlWidth) img.style.width = htmlWidth + 'px';
      if (htmlHeight) img.style.height = htmlHeight + 'px';
    });
  });
</script>

{% schema %}
  {
    "name": "t:sections.main-article.name",
    "settings": [
      {
        "type": "header",
        "content": "Job Postings"
      },
      {
        "type": "textarea",
        "id": "equal_employment_disclaimer",
        "label": "Equal Employment Disclaimer"
      },
      {
        "type": "text",
        "id": "careers_contact_email",
        "label": "Application email",
        "info": "Email address for apply now button",
        "default": "hello@sauna.space"
      },
      {
        "type": "text",
        "id": "apply_now_text",
        "label": "Apply Now Button Text",
        "default": "Apply Now"
      }
    ],
    "blocks": [
      {
        "type": "@app"
      }
    ]
  }
{% endschema %}
