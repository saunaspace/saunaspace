{%- if predictive_search.performed -%}
<div id="predictive-search-results motion-reduce">
  <div class="container container--extra-large predictive-search-container">
    {% assign total_count = predictive_search.resources.products.size | plus: predictive_search.resources.pages.size | plus: predictive_search.resources.articles.size %}
    <div class="results-header">
      <p>{{ total_count }} Result{% unless total_count == 1 %}s{% endunless %} Found For <span class="search-term">"{{ predictive_search.terms }}"</span></p>
    </div>

    {%- if predictive_search.resources.products.size > 0 -%}
    <div class="ps-products-container">
      <p class="header__search-results-title h6">
        {{- 'predictive_search.title_products' | t -}}
      </p><!-- /.header__search-results-title -->

      <div class="predictive-search-items collection__grid predictive-search-items--products">
        {%- for product_resource in predictive_search.resources.products -%}
          {% if product_resource.metafields.custom.search_visible == false %}
            {% continue %}
          {% endif %}
          {% render 'predictive-search-item',
            class: 'predictive-search__item--product search-item--product',
            heading_class: 'caption caption--small',
            resource_item: product_resource,
            image: product_resource.featured_image,
            show_image: true,
            is_product: true
          %}
        {%- endfor -%}
      </div>

      <div class="predictive-search__actions">
        {%-
          liquid
          assign link_text = 'predictive_search.see_all_products' | t
          assign link_url = routes.search_url | append: '?q=' | append: predictive_search.terms | append: '&type=product' | append: '&options[prefix]=last'
          render 'button', type: 'link', href: link_url, value: link_text
        -%}
      </div><!-- /.predictive-search__actions -->
    </div>
    {%- else -%}
      <p class="header__search-results-empty p4 visually-hidden">{{ 'predictive_search.no_results' | t }}</p><!-- /.header__search-results-empty p4 -->
    {%- endif -%}


    {%- if predictive_search.resources.articles.size > 0 or predictive_search.resources.pages.size > 0 -%}
    <div class="ps-articles-container">
      <p class="header__search-results-title h6">{{ 'predictive_search.title_articles_and_pages' | t }}</p><!-- /.header__search-results-title h5 -->

      <div class="predictive-search--articles-pages">
        <div class="predictive-search-items collection__grid predictive-search-items--articles-pages">
          {%- for page_resource in predictive_search.resources.pages limit: 3 -%}
            {% if page_resource.metafields.custom.search_visible == false %}
              {% continue %}
            {% endif %}
            {% liquid 
              assign image = 'image' | placeholder_svg_tag
              if page_resource.metafields.page.featured_image != empty
                assign image = page_resource.metafields.page.featured_image
              endif
            %}
            {% render 'predictive-search-item',
                class: 'predictive-search__item--page search-item--page',
                heading_class: 'h6 caption',
                resource_item: page_resource,
                image: image,
                show_image: true
            %}
          {%- endfor -%}

          {%- for article_resource in predictive_search.resources.articles limit: 3 -%}
            {% if article_resource.metafields.custom.search_visible == false %}
              {% continue %}
            {% endif %}
            {% liquid 
              assign image = 'image' | placeholder_svg_tag
              if article_resource.image != blank
                assign image = article_resource.image
              endif
            %}
            {% render 'predictive-search-item',
                class: 'predictive-search__item--article search-item--article',
                heading_class: 'h6 caption',
                resource_item: article_resource,
                image: image,
                show_image: true
            %}
          {%- endfor -%} 
        </div>

        <div class="predictive-search__actions">
          {%-
            liquid
            assign link_text = 'predictive_search.see_all_results' | t
            assign link_url = routes.search_url | append: '?q=' | append: predictive_search.terms | append: '&type=article,page' | append: '&options[prefix]=last'
            render 'button', type: 'link', href: link_url, value: link_text
          -%}
        </div><!-- /.predictive-search__actions -->
      </div>
    </div>
    {%- else -%}
      <p class="header__search-results-empty p4 visually-hidden">No Results</p><!-- /.header__search-results-empty p4 -->
    {%- endif -%}

  </div>
</div>
{%- endif -%}