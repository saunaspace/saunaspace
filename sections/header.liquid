{{- 'section-header.css' | asset_url | stylesheet_tag -}}
{{- 'component-card-feature.css' | asset_url | stylesheet_tag -}}

{%- if settings.enable_predictive_search -%}
  <link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}" media="print" onload="this.media='all'">

  <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%-
  liquid
  assign class = 'header header--transparent js-header'
  assign disabled_transparent_header_templates = 'collection,list-collections,cart,404,search,contact' | split: ','
  assign has_template_name = false
  assign has_template_suffix = false

  if disabled_transparent_header_templates contains template.name
    assign has_template_name = true
  elsif template.name == 'page' and page.metafields.custom.show_default_header == true
    assign has_template_name = true
  endif

  if disabled_transparent_header_templates contains template.suffix
    assign has_template_suffix = true
  endif

  assign is_disabled_pdp_template = false
  if template.name == 'product' and template.suffix == 'gallery-bar'
    assign is_disabled_pdp_template = true
  endif

  # if template.name == 'product' and template.suffix == 'sauna'
  if template.name == 'product'
    assign is_disabled_pdp_template = true
    assign class = class | append: ' header--shadow header--logo-small'
  endif

  assign is_contact_page = false
  if template.name == 'page' and template.suffix == 'contact'
    assign is_contact_page = true
  endif

  if is_contact_page == false
    if template.directory == 'customer' or has_template_name or has_template_suffix or is_disabled_pdp_template or template.suffix contains "zipify"
      comment
        /* or request.path contains '/policies/' */
      endcomment
      assign class = class | remove_first: ' header--transparent'
    endif
  endif
-%}

<script>
  console.log({{ request.path | json }});
</script>

<header class="{{- class -}}">
  <div class="container container--fullwidth">
    <div class="header__inner">
      <div class="header__logo">
        <a href="{{- routes.root_url -}}" class="inline-unstyled-link relative">
          {%- if section.settings.logo != blank -%}
            {%- assign logo_image_size_2x = section.settings.logo.width | times: 2 | at_most: 5760 -%}

            <img
              class="header__logo-image{% if section.settings.logo_inversed != blank %} header__logo-image--main{% endif %}"
              srcset="{{ section.settings.logo | image_url: width: section.settings.logo.width }} 1x, {{ section.settings.logo | image_url: width: logo_image_size_2x }} 2x"
              src="{{- section.settings.logo | image_url: width: section.settings.logo.width -}}"
              loading="lazy"
              width="{{- section.settings.logo.width -}}"
              height="{{- section.settings.logo.height -}}"
              alt="{{- section.settings.logo.alt | default: shop.name | escape -}}"
            >

            {%- if section.settings.logo_inversed != blank -%}
              {%- assign logo_image_size_2x = section.settings.logo_inversed.width | times: 2 | at_most: 5760 -%}

              <img
                class="header__logo-image header__logo-image--inversed"
                srcset="{{ section.settings.logo_inversed | image_url: width: section.settings.logo_inversed.width }} 1x, {{ section.settings.logo_inversed | image_url: width: logo_image_size_2x }} 2x"
                src="{{- section.settings.logo_inversed | image_url: width: section.settings.logo_inversed.width -}}"
                loading="lazy"
                width="{{- section.settings.logo_inversed.width -}}"
                height="{{- section.settings.logo_inversed.height -}}"
                alt="{{- section.settings.logo_inversed.alt | default: shop.name | escape -}}"
                aria-hidden="true"
              >
            {%- endif -%}
            
            {%- if section.settings.logo_mark != blank -%}
              {%- assign logo_image_size_2x = section.settings.logo_mark.width | times: 2 | at_most: 5760 -%}

              <img
                class="header__logo-image header__logo-image--mark"
                srcset="{{ section.settings.logo_mark | image_url: width: section.settings.logo_mark.width }} 1x, {{ section.settings.logo_mark | image_url: width: logo_image_size_2x }} 2x"
                src="{{- section.settings.logo_mark | image_url: width: section.settings.logo_mark.width -}}"
                loading="lazy"
                width="{{- section.settings.logo_mark.width -}}"
                height="{{- section.settings.logo_mark.height -}}"
                alt="{{- section.settings.logo_mark.alt | default: shop.name | escape -}}"
                aria-hidden="true"
              >
            {%- endif -%}
          {%- endif -%}

          <span
            class="{% if section.settings.logo == blank %}h4{% else %}visually-hidden{% endif %}"
          >{{- shop.name | escape -}}</span>
        </a>
      </div><!-- /.header__logo -->

      {%- if linklists[section.settings.menu].links.size > 0 -%}
        {% liquid
          if section.settings.mobile_menu != blank
            assign mobile_menu = linklists[section.settings.mobile_menu]
          else
            assign mobile_menu = linklists[section.settings.menu]
          endif
        %}
        {%- render 'navigation-mobile', menu: mobile_menu -%}

        <nav class="header__nav small-hide medium-hide">
          <ul class="header__nav-items list-unstyled">
            {%- for link in linklists[section.settings.menu].links -%}
              {%- assign dropdown_class = 'header__nav-dropdown' -%}
              {%- assign is_stacked = false -%}
              {% assign small_links = false %}

              {%- capture menu_cards_html -%}
                {%- for block in section.blocks -%}
                  {%- liquid
                    if block.settings.link_title != link.title
                      continue
                    endif

                    if block.settings.enable_fullwidth
                      assign dropdown_class = dropdown_class | append: ' header__nav-dropdown--fullwidth'
                    endif

                    if block.settings.links_layout == 'stacked'
                      assign dropdown_class = dropdown_class | append: ' header__nav-dropdown--stacked'
                      assign is_stacked = true
                    endif

                    assign small_links = block.settings.reduce_links_fs
                  -%}

                  {%- for i in (1..3) -%}
                    {%- liquid
                      assign image_setting_handle = 'card_image_' | append: i
                      assign title_setting_handle = 'card_title_' | append: i
                      assign button_first_label_setting_handle = 'card_button_first_label_' | append: i
                      assign button_first_url_setting_handle = 'card_button_first_url_' | append: i
                      assign button_second_label_setting_handle = 'card_button_second_label_' | append: i
                      assign button_second_url_setting_handle = 'card_button_second_url_' | append: i

                      if block.settings[image_setting_handle] == blank
                        continue
                      endif

                      capture buttons_html
                        if block.settings[button_first_label_setting_handle] != blank and block.settings[button_first_url_setting_handle] != blank
                          assign value = block.settings[button_first_label_setting_handle] | escape
                          render 'button' with type: 'link', value: value, href: block.settings[button_first_url_setting_handle], style: 'blurred'
                        endif

                        if block.settings[button_second_label_setting_handle] != blank and block.settings[button_second_url_setting_handle] != blank
                          assign value = block.settings[button_second_label_setting_handle] | escape
                          render 'button' with type: 'link', value: value, href: block.settings[button_second_url_setting_handle], style: 'orange'
                        endif
                      endcapture
                      assign buttons_html = buttons_html | strip
                    -%}

                    <div class="header__nav-card">
                      <div class="card-feature card-feature--{{ block.settings.cards_layout }}">
                        <div class="card-feature__media">
                          <div class="media">
                            {%- render 'image' with image: block.settings[image_setting_handle] -%}
                          </div><!-- /.media -->

                          {%- if buttons_html != '' -%}
                            <div class="card-feature__buttons">
                              <div class="card-feature__buttons-inner">
                                {{ buttons_html }}
                              </div><!-- /.card-feature__buttons-inner -->
                            </div><!-- /.card-feature__buttons -->
                          {%- endif -%}
                        </div><!-- /.card-feature__media -->

                        {%- if block.settings[title_setting_handle] != blank -%}
                          <p class="card-feature__title">
                            {{- block.settings[title_setting_handle] | escape -}}
                          </p><!-- /.card-feature__title -->
                        {%- endif -%}
                      </div><!-- /.card-feature -->
                    </div><!-- /.header__nav-card -->
                  {%- endfor -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- assign menu_cards_html = menu_cards_html | strip -%}

              {%- if menu_cards_html != '' -%}
                {%- assign dropdown_class = dropdown_class | append: ' header__nav-dropdown--large' -%}
              {%- endif -%}

              <li class="header__nav-item{% if menu_cards_html == '' %} relative{% endif %}">
                <a href="{{- link.url -}}" class="header__nav-link full-unstyled-link focus-inset{% if link.child_active %} is-current{% endif %}"{% if link.current %} aria-current="page"{% endif %}>
                  {{- link.title | escape -}}

                  {%- if link.links.size > 0 -%}
                    <span class="header__nav-link-icon icon">
                      <span>
                        {%- render 'icon-chevron-down' -%}
                      </span>

                      <span>
                        {%- render 'icon-minus-alt' -%}
                      </span>
                    </span><!-- /.header__nav-link-icon -->
                  {%- endif -%}
                </a>

                {%- if link.links.size > 0 -%}
                  {%- assign grand_child_items_html = '' -%}

                  <div class="{{ dropdown_class }}" tabindex="-1">
                    <div class="header-nav__dropdown-wrapper">
                      <div class="header__nav-dropdown-inner">
                        <div class="header__nav-menu{% if small_links %} smaller-links{% endif %}">
                          <ul class="header__nav-links list-unstyled">
                            {%- for child_link in link.links -%}
                              <li class="header__nav-links-item">
                                <a href="{{- child_link.url -}}" class="header__nav-dropdown-link full-unstyled-link focus-inset{% if child_link.current %} is-current{% endif %}" aria-label="{{- child_link.title | escape -}}"{% if child_link.current %} aria-current="page"{% endif %}>
                                  <span>{{- child_link.title | escape -}}</span>

                                  {%- if child_link.links.size > 0 and menu_cards_html == '' -%}
                                    {%- render 'icon-chevron-right' -%}
                                  {%- endif -%}
                                </a>

                                {%- capture grand_child_links_html -%}
                                  {%- for grand_child_link in child_link.links -%}
                                    <li class="header__nav-sublinks-item">
                                      <a href="{{- grand_child_link.url -}}" class="header__nav-dropdown-link full-unstyled-link focus-inset{% if grand_child_link.current %} is-current{% endif %}"{% if grand_child_link.current %} aria-current="page"{% endif %}>{{- grand_child_link.title | escape -}}</a>
                                    </li><!-- /.header__nav-sublinks-item -->
                                  {%- endfor -%}
                                {%- endcapture -%}

                                {%- if is_stacked -%}
                                  {%- assign grand_child_items_html = grand_child_items_html | append: grand_child_links_html -%}

                                  {%- continue -%}
                                {%- endif -%}

                                {%- if child_link.links.size > 0 -%}
                                  <ul class="header__nav-sublinks list-unstyled">
                                    {{ grand_child_links_html }}
                                  </ul><!-- /.header__nav-sublinks list-unstyled -->
                                {%- endif -%}
                              </li><!-- /.header__nav-links-item -->
                            {%- endfor -%}
                          </ul><!-- /.header__nav-links list-unstyled -->

                          {%- if grand_child_items_html != '' -%}
                            <ul class="header__nav-sublinks list-unstyled">
                              {{ grand_child_items_html }}
                            </ul><!-- /.header__nav-sublinks list-unstyled -->
                          {%- endif -%}
                        </div><!-- /.header__nav-menu -->

                        {%- if menu_cards_html != '' -%}
                          <div class="header__nav-cards">
                            <div class="header__nav-cards-inner flex flex--grid">
                              {{ menu_cards_html }}
                            </div><!-- /.header__nav-cards-inner -->
                          </div><!-- /.header__nav-cards -->
                        {%- endif -%}
                      </div><!-- /.header__nav-dropdown-inner -->
                    </div><!-- /.header-nav__dropdown-wrapper -->
                  </div><!-- /.header__nav-dropdown -->
                {%- endif -%}
              </li><!-- /.header__nav-item -->
            {%- endfor -%}
          </ul><!-- /.header__nav-items list-unstyled -->
        </nav><!-- /.header__nav -->
      {%- endif -%}

      <nav class="header__utils">
        <ul class="header__utils-items list-unstyled">
          <li class="header__utils-item header__utils-item--cart">
            <a href="{{ routes.search_url }}" class="header__utils-link full-unstyled-link focus-inset{% if settings.enable_predictive_search and template != "search" %} js-search-popup-trigger{% endif %}" title="Search Site" id="search-link">
              {%- render 'icon-search' -%}
            </a>
          </li>

          <li class="header__utils-item header__utils-item--cart">
            <a href="{{- routes.cart_url -}}" class="header__utils-link full-unstyled-link focus-inset" title="{{- 'accessibility.cart' | t -}}" id="cart-counter" data-cart-link>
              {%- render 'cart-counter' -%}
            </a>
          </li><!-- /.header__utils-item -->

          {%- if shop.customer_accounts_enabled -%}
            <li class="header__utils-item">
              <a href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" class="header__utils-link full-unstyled-link focus-inset" title="{%- if customer -%}{{ 'accessibility.account' | t }}{%- else -%}{{ 'accessibility.sign_in' | t }}{%- endif -%}">
                {%- render 'icon-user' -%}
              </a>
            </li><!-- /.header__utils-item -->
          {%- endif -%}
        </ul><!-- /.header__utils-items list-unstyled -->
      </nav><!-- /.header__utils -->
    </div><!-- /.header__inner -->
  </div><!-- /.container -->
</header><!-- /.header -->

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if section.settings.logo != blank %}
      "logo": {{ section.settings.logo | image_url: width: section.settings.logo.width | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: "?q={search_term_string}" %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
  {
    "name": "t:sections.header.name",
    "class": "site-header js-sticky-header-item",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "image_picker",
        "id": "logo_inversed",
        "label": "Logo inversed",
        "info": "Visible when header is transparent"
      },
      {
        "type": "image_picker",
        "id": "logo_mark",
        "label": "Logo mark",
        "info": "Visible on desktop when scrolling down"
      },
      {
        "type": "link_list",
        "id": "menu",
        "default": "main-menu",
        "label": "t:sections.header.settings.menu.label"
      },
      {
        "type": "link_list",
        "id": "mobile_menu",
        "label": "Mobile Menu"
      },
      {
        "type": "product_list",
        "id": "mobile_featured_products",
        "label": "Mobile Featured Products",
        "info": "Subtitle text can be found in the product metafields",
        "limit": 3
      },
      {
        "type": "text",
        "id": "mobile_featured_1_description",
        "label": "Mobile Product 1 description",
        "default": "Discover the ultimate wellness haven"
      },
      {
        "type": "text",
        "id": "mobile_featured_2_description",
        "label": "Mobile Product 2 description",
        "default": "Transform your space into a sanctuary"
      },
      {
        "type": "text",
        "id": "mobile_featured_3_description",
        "label": "Mobile Product 3 description",
        "default": "Bask in radiant light, anytime & anywhere"
      }
    ],
    "blocks": [
      {
        "type": "mega-menu",
        "name": "Mega menu",
