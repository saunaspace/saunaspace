{%-
  liquid
  assign video = section.settings.video
  assign overlay_image = section.settings.overlay_image
  assign overlay_image_mobile = section.settings.overlay_image_mobile
  assign heading = section.settings.heading
  assign content = section.settings.content
  assign button_text = section.settings.button_text
  assign button_url = section.settings.button_url
  assign overlay_opacity = section.settings.overlay_opacity
-%}
{% liquid
  if section.settings.section_id != blank
    assign sec_id = section.settings.section_id
  else
    assign sec_id = "section-video-" | append: section.index
  endif
%}

<link rel="stylesheet" href="{{ 'video.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>
  {{- 'video.css' | asset_url | stylesheet_tag -}}
</noscript>

{% style %}
  [data-id="video-{{- section.id -}}"] {
    --opacity: {{- overlay_opacity |  divided_by: 100.0 -}};
  }
{% endstyle %}

<section data-id="video-{{- section.id -}}" class="video" id="{{ sec_id }}">
  <div class="container container--fullwidth">
    <div class="video__video">
      {%- if video != blank -%}
        {{- video | video_tag: autoplay: true, loop: true, muted: true -}}
      {%- else -%}
        {{- 'image' | placeholder_svg_tag -}}
      {%- endif -%}
    </div><!-- /.video__video -->

    {%- if overlay_image != blank -%}
      <div class="video__image media media--transparent{% if overlay_image_mobile != blank %} small-hide medium-hide{% endif %}" aria-hidden="true">
        {%- render 'image', image: overlay_image -%}
      </div><!-- /.video__image media -->
    {%- endif -%}

    {%- if overlay_image_mobile != blank -%}
      <div class="video__image media media--transparent large-up-hide" aria-hidden="true">
        {%- render 'image', image: overlay_image_mobile -%}
      </div><!-- /.video__image media -->
    {%- endif -%}

    <div class="video__inner">
      {%- if heading != blank -%}
        <h2 class="video__heading">
          {{- heading | escape -}}
        </h2><!-- /.video__heading -->
      {%- endif -%}

      {%- if content != blank -%}
        <div class="video__content rte">
          {{- content -}}
        </div><!-- /.video__content -->
      {%- endif -%}

      {%- if button_text != blank and button_url != blank -%}
        {%- render 'button',
          type: 'link',
          style: 'secondary-outlined button--orange-hover button--large-desktop',
          value: button_text,
          href: button_url
        -%}
      {%- endif -%}
    </div><!-- /.video__inner -->
  </div><!-- /.container container--fullwidth -->
</section><!-- /.video -->

{% schema %}
{
  "name": "Video",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "A Shopify-hosted video"
    },
    {
      "type": "image_picker",
      "id": "overlay_image",
      "label": "Overlay image"
    },
    {
      "type": "image_picker",
      "id": "overlay_image_mobile",
      "label": "Overlay mobile image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 40
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "section_id",
      "label": "Section ID"
    }
  ],
  "presets": [
    {
      "name": "Video",
      "settings": {
        "heading": "Heading Goes Here",
        "content": "<p>Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum. Stet clita kasd gubergren, no sea.</p>",
        "button_text": "Button text",
        "button_url": "/"
      }
    }
  ],
  "disabled_on": {
    "groups": ["*"]
  }
}
{% endschema %}
