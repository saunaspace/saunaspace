{% liquid
  if section.settings.section_id != blank
    assign sec_id = section.settings.section_id
  else
    assign sec_id = "section-banner-radial-" | append: section.index
  endif
%}
{%- if section.settings.title != blank -%}
  <section class="banner-radial{% if section.settings.content != blank %} banner-radial--has-content{% endif %}" id="{{ sec_id }}">
    <div class="banner__head">
      <div class="container">
        <h2 class="banner__title">
          {{- section.settings.title | escape | newline_to_br -}}
        </h2><!-- /.banner__title -->
      </div><!-- /.container -->
    </div><!-- /.banner__head -->

    {%- if section.settings.content != blank -%}
      <div class="banner-radial__content">
        {{- section.settings.content | escape | newline_to_br -}}
      </div><!-- /.banner-radial__content -->
    {%- endif -%}
  </section><!-- /.banner-radial -->

  {% style %}
    .banner-radial {
      aspect-ratio: 16 / 9;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 11rem 0;
      color: #f4f0e0;
      background: #000;
    }

    .banner-radial .banner__head {
      background: radial-gradient(closest-side, #ff3a00, transparent);
      background-size: 100%;
      background-repeat: no-repeat;
      background-position: center;
      width: 96rem;
      margin: 0 auto;
      aspect-ratio: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .banner-radial--has-content {
      justify-content: flex-start;
      padding: 0 6.6rem;
    }

    .banner-radial--has-content .banner__head {
      margin: 0;
    }

    .banner-radial .banner__head h2 {
      font-size: calc(var(--fsbase) * 5.4);
      max-width: 55rem;
      margin: 0 auto;
    }

    .banner-radial--has-content .banner__head h2 {
      font-size: calc(var(--fsbase) * 4.8);
      line-height: 1.625;
    }

    .banner-radial__content {
      font-size: calc(var(--fsbase) * 2.1);
      line-height: 2;
      text-align: center;
      max-width: 69rem;
    }

    @media screen and (max-width: 1439px) {
      .banner-radial__content {
        max-width: 50%;
      }
    }

    @media screen and (max-width: 1359px) {
      .banner-radial .banner__head h2,
      .banner-radial--has-content .banner__head h2 {
        font-size: calc(var(--fsbase) * 2.4);
        line-height: 1.5;
      }

      .banner-radial__content {
        font-size: calc(var(--fsbase) * 1.2);
      }
    }

    @media screen and (max-width: 1023px) {
      .banner-radial--has-content {
        display: block;
        padding: 0;
      }

      .banner-radial--has-content .banner__head {
        max-width: 100%;
      }

      .banner-radial__content {
        padding: 4rem 4rem 3rem;
        max-width: 100%;
      }
    }

    @media screen and (max-width: 749px) {
      .banner-radial {
        aspect-ratio: initial;
      }

      .banner-radial .banner__head h2 {
        font-size: calc(var(--fsbase) * 2.4);
      }
    }
  {% endstyle %}
{%- endif -%}

{% schema %}
  {
    "name": "Banner with radial image",
    "settings": [
      {
        "type": "textarea",
        "id": "title",
        "label": "Heading"
      },
      {
        "type": "textarea",
        "id": "content",
        "label": "Content"
      },
      {
        "type": "text",
        "id": "section_id",
        "label": "Section ID"
      }
    ],
    "disabled_on": {
      "groups": ["*"]
    },
    "presets": [
      {
        "name": "Banner with radial image"
      }
    ]
  }
{% endschema %}
