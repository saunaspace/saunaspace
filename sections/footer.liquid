{{- 'section-footer.css' | asset_url | stylesheet_tag -}}

<footer class="footer">
  <div class="container container--fullwidth">
    <div class="footer__inner">
      <div class="footer__aside">
        <div class="footer__logo">
          <a href="{{- routes.root_url -}}" class="footer__logo inline-unstyled-link">
            {%- if section.settings.logo_svg_code != blank -%}
              {{- section.settings.logo_svg_code -}}
            {%- elsif section.settings.logo != blank -%}
              {%- assign logo_image_size_2x = section.settings.logo.width | times: 2 | at_most: 5760 -%}

              <img
                srcset="{{ section.settings.logo | image_url: width: section.settings.logo.width }} 1x, {{ section.settings.logo | image_url: width: logo_image_size_2x }} 2x"
                src="{{- section.settings.logo | image_url: width: section.settings.logo.width -}}"
                loading="lazy"
                width="{{- section.settings.logo.width -}}"
                height="{{- section.settings.logo.height -}}"
                alt="{{- section.settings.logo.alt | default: shop.name | escape -}}"
                style="object-position: {{ section.settings.logo.presentation.focal_point }}"
              >
            {%- endif -%}

            <span
              class="{% if section.settings.logo == blank and section.settings.logo_svg_code == blank %}h4{% else %}visually-hidden{% endif %}"
            >{{- shop.name | escape -}}</span>
          </a>
        </div><!-- /.footer__logo -->

        <p class="footer__copyright small-hide medium-hide">
          &copy; 2013-{{ 'now' | date: '%Y' }} <a href="{{- routes.root_url -}}" class="inline-unstyled-link">{{- shop.name | escape -}} &reg;</a>
        </p><!-- /footer__copyright -->
      </div><!-- /.footer__aside -->

      <div class="footer__body">
        <nav class="footer__nav small-hide medium-hide">
          <ul class="footer__links list-unstyled">
            {%- for link in linklists[section.settings.menu].links -%}
              <li class="footer__links-item">
                <span class="footer__links-item__title full-unstyled-link focus-inset{% if link.links.size > 0 %} bold{% endif %}">{{- link.title | escape -}}</span>

                {%- if link.links.size > 0 -%}
                  <ul class="footer__sublinks list-unstyled">
                    {%- for sublink in link.links -%}
                      <li class="footer__sublinks-item">
                        <a href="{{- sublink.url -}}" class="footer__sublinks-link full-unstyled-link focus-inset">{{- sublink.title | escape -}}</a>
                      </li><!-- /.footer__sublinks-item -->
                    {%- endfor -%}
                  </ul><!-- /.footer__sublinks list-unstyled -->
                {%- endif -%}
              </li><!-- /.footer__links-item -->
            {%- endfor -%}

            {%- if section.settings.contact_heading != blank or section.settings.contact_info != blank or section.settings.hours != blank -%}
              <li class="footer__links-item footer__links-item--contact">
                <span class="footer__links-item__title full-unstyled-link focus-inset{% if section.settings.contact_info != blank %} bold{% endif %}">
                  {{ section.settings.contact_heading }}
                </span>

                {%- if section.settings.contact_info != blank or section.settings.hours != blank -%}
                  <ul class="footer__sublinks list-unstyled">
                    <li class="footer__sublinks-item">
                      {%- if section.settings.hours != blank -%}
                        <p class="footer__hours">{{ section.settings.hours }}</p>
                      {%- endif -%}

                      {%- render 'socials', class: 'footer__socials large-up-hide' -%}

                      {%- if section.settings.contact_info != blank -%}
                        <div class="footer__info">
                          {{ section.settings.contact_info }}
                        </div><!-- /.footer__info -->
                      {%- endif -%}
                    </li><!-- /.footer__sublinks-item -->
                  </ul><!-- /.footer__sublinks list-unstyled -->
                {%- endif -%}
              </li>
            {%- endif -%}
          </ul><!-- /.footer__links list-unstyled -->
        </nav><!-- /.footer__nav -->

        {%- render 'footer-nav-mobile' class: 'large-up-hide' -%}

        <div class="footer__bottom">
          {%- render 'socials', class: 'footer__socials small-hide medium-hide' -%}

          <div class="footer__menu">
            <ul class="list-unstyled">
              {%- for link in linklists[section.settings.menu_policies].links -%}
                <li>
                  <a href="{{- link.url -}}">{{- link.title | escape -}}</a>
                </li><!-- /.footer__links-item -->
              {%- endfor -%}
            </ul><!-- /.list-unstyled -->
          </div><!-- /.footer__menu -->

          <p class="footer__copyright large-up-hide">
            &copy; 2013-{{ 'now' | date: '%Y' }} <a href="{{- routes.root_url -}}" class="inline-unstyled-link">{{- shop.name | escape -}} &reg;</a>
          </p><!-- /footer__copyright -->
        </div><!-- /.footer__bottom -->
      </div><!-- /.footer__body -->
    </div><!-- /.footer__inner -->
  </div><!-- /.container -->
</footer><!-- /.footer -->

{% schema %}
  {
    "name": "t:sections.footer.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:sections.footer.settings.logo.label"
      },
      {
        "type": "html",
        "id": "logo_svg_code",
        "label": "t:sections.footer.settings.logo_svg_code.label",
        "info": "t:sections.footer.settings.logo_svg_code.info"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 500,
        "step": 5,
        "unit": "px",
        "label": "t:sections.footer.settings.logo_width.label",
        "default": 490
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "max": 235,
        "min": 50,
        "step": 5,
        "unit": "px",
        "label": "t:sections.footer.settings.logo_width_mobile.label",
        "default": 235
      },
      {
        "type": "link_list",
        "id": "menu",
        "default": "footer",
        "label": "t:sections.footer.settings.menu.label"
      },
      {
        "type": "link_list",
        "id": "menu_policies",
        "default": "footer",
        "label": "t:sections.footer.settings.menu_policies.label"
      },
      {
        "type": "header",
        "content": "t:sections.footer.settings.header_contact.content"
      },
      {
        "type": "text",
        "id": "contact_heading",
        "label": "Heading",
        "default": "t:sections.footer.settings.contact_heading.label"
      },
      {
        "type": "textarea",
        "id": "hours",
        "label": "t:sections.footer.settings.hours.label"
      },
      {
        "type": "richtext",
        "id": "contact_info",
        "label": "t:sections.footer.settings.contact_info.label"
      }
    ]
  }
{% endschema %}
