{{- 'component-card-product.css' | asset_url | stylesheet_tag -}}

<product-recommendations
  class="block"
  data-url="{{- routes.product_recommendations_url -}}?section_id={{- section.id -}}&product_id={{- product.id -}}&limit=3&intent=related"
>
  {%- assign resources = nil -%}
  {% if product.metafields.my_fields.product_recommendations != blank %}
    {%- assign resources = product.metafields.my_fields.product_recommendations.value -%}
  {%- elsif recommendations.performed and recommendations.products_count > 0 -%}
    {%- assign resources = recommendations.products -%}
  {%- endif -%}

  <section class="product-recommendations hidden">
    <div class="container container--gutter-mobile">
      {%- if section.settings.title != blank -%}
        <h2 class="product-recommendations__title">
          {{- section.settings.title | escape -}}
        </h2><!-- /.product-recommendations__title -->
      {%- endif -%}

      <ul class="product-recommendations__list list-unstyled" data-container-products>
        {%- for resource in resources -%}
          <li class="product-recommendations__item">
            {%- render 'card-product', product_ref: resource -%}
          </li><!-- /.product-recommendations__item -->
        {%- endfor -%}
      </ul><!-- /.product-recommendations__list list-unstyled -->
    </div><!-- /.container -->
  </section><!-- /.product-recommendations -->
</product-recommendations>

<script src="{{- 'product-recommendations.js' | asset_url -}}" defer="defer"></script>

{% style %}
  .product-recommendations {
    color: #2c2621;
    padding: 10rem 0 11.4rem;
    border-top: 0.1rem solid #b1b1b1;
  }

  .product-recommendations .container {
    max-width: 162rem;
  }

  .product-recommendations__title {
    text-align: center;
    font-size: calc(var(--fsbase) * 5.4);
    line-height: 1.444444;
    font-weight: 500;
    margin: 0 0 6rem;
  }

  .product-recommendations__image {
    aspect-ratio: 1;
    border-radius: 1rem;
    margin-bottom: 2rem;
  }

  .product-recommendations__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.3rem;
  }

  .product-recommendations__heading {
    font-family: var(--font-body-family);
    font-size: calc(var(--fsbase) * 2.1);
    line-height: 1.333333;
    font-weight: 700;
    text-transform: uppercase;
  }

  .product-recommendations__content {
    display: flex;
    flex-flow: row wrap;
    gap: 1.7rem;
  }

  .product-recommendations__entry {
    flex: 1;
  }

  .product-recommendations__reviews {
    --oke-stars-foregroundColor: #ff3a00;
    --oke-stars-backgroundColor: #b1b1b1;
  }

  .product-recommendations__reviews .oke-sr-count-number,
  .product-recommendations__reviews .oke-sr-label-text {
    font-size: 1rem !important;
  }

  .product-recommendations__reviews .oke-stars-background > svg,
  .product-recommendations__reviews .oke-stars-foreground > svg {
    height: 1rem !important;
  }

  .product-recommendations__reviews [data-oke-star-rating] .okeReviews > div {
    display: flex;
    align-items: center;
  }

  .product-recommendations__reviews .oke-sr-stars {
    margin-top: 0.2rem;
  }

  @media screen and (min-width: 750px) {
    .product-recommendations .card-product__media {
      padding-bottom: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .product-recommendations {
      padding: 4rem 0;
    }

    .product-recommendations__title {
      font-size: calc(var(--fsbase) * 2.4);
      margin: 0 0 3rem;
    }

    .product-recommendations__image {
      aspect-ratio: 313 / 209;
      margin: 0 0 0.9rem;
    }

    .product-recommendations__list {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .product-recommendations__heading {
      font-size: calc(var(--fsbase) * 1.6);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.product-recommendations.name",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.product-recommendations.settings.title.label",
      "default": "You May Also Like"
    }
  ]
}
{% endschema %}
